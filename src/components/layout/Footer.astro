---
import { MAX_WIDTH } from '@constants/layout';
import { icpConfig, siteConfig } from '@constants/site-config';
import { getSiteStats } from '@lib/stats';
import { cn } from '@lib/utils';
import { Icon } from 'astro-icon/components';
import { getLocaleFromUrl, localizedPath, t } from '@/i18n';
import SakuraSVG from '../svg/SakuraSvg';

interface Props {
  className?: string;
}

const { className } = Astro.props;

const locale = getLocaleFromUrl(Astro.url.pathname);
const stats = await getSiteStats();
const currentYear = new Date().getFullYear();
const startYear = siteConfig?.startYear ?? currentYear;
const archivesHref = localizedPath('/archives', locale);
const aboutHref = localizedPath('/about', locale);
---

<footer class={cn('footer-colophon corner-petal-mark mt-auto pt-6 pb-7', className)}>
  <svg class="celestial-footer-arc" viewBox="0 0 176 104" fill="none" aria-hidden="true">
    <path d="M8 94C36 42 94 16 168 24" stroke="currentColor" stroke-width="0.9" stroke-dasharray="3 4" />
    <path d="M28 74L72 44L122 52" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.7" />
    <circle cx="28" cy="74" r="1.8" fill="currentColor" />
    <path d="M72 38L73.4 42.6L78 44L73.4 45.4L72 50L70.6 45.4L66 44L70.6 42.6Z" fill="currentColor" />
    <circle cx="122" cy="52" r="1.5" fill="currentColor" fill-opacity="0.8" />
  </svg>
  <span class="corner-petal-watermark right-6 bottom-3 size-14 opacity-45 md:hidden" aria-hidden="true" />
  <div class={cn('relative z-10 mx-auto flex flex-col items-center gap-3.5 px-6 md:px-3 md:pb-10', MAX_WIDTH.content)}>
    <!-- Ornamental Colophon Divider -->
    <div class="editorial-ornament-divider max-w-md" aria-hidden="true">
      <span class="celestial-star celestial-star-sm opacity-75" />
      <span class="editorial-ornament-petal" />
      <span class="celestial-star celestial-star-sm opacity-75" />
    </div>

    <!-- Brand Signature Lockup -->
    {siteConfig?.title && (
      <div class="flex flex-col items-center gap-0.5 text-center">
        <a
          href={localizedPath('/', locale)}
          class="font-chill-round text-foreground/85 hover:text-primary text-sm font-semibold tracking-[0.14em] transition-colors"
        >
          {siteConfig.title}
        </a>
        {siteConfig?.subtitle && (
          <p class="text-muted-foreground/80 max-w-md text-xs tracking-wide">{siteConfig.subtitle}</p>
        )}
      </div>
    )}

    <!-- Site Stats (semantic non-interactive readouts backed by real build stats) -->
    <div class="text-muted-foreground flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm md:gap-x-3.5">
      <span class="footer-stat-chip" title={t(locale, 'footer.totalWordsTitle')}>
        <Icon name="ri:file-text-line" class="text-primary/75 h-4 w-4" aria-hidden="true" />
        <span class="font-medium">{stats.formattedWords}</span>
        <span class="text-xs">{t(locale, 'footer.wordUnit')}</span>
      </span>

      <span class="bg-border/75 h-3.5 w-px" aria-hidden="true"></span>

      <span class="footer-stat-chip" title={t(locale, 'footer.readingTimeTitle')}>
        <Icon name="ri:time-line" class="text-primary/75 h-4 w-4" aria-hidden="true" />
        <span class="font-medium">{stats.formattedTime}</span>
      </span>

      <span class="bg-border/75 h-3.5 w-px" aria-hidden="true"></span>

      <span class="footer-stat-chip" title={t(locale, 'footer.postCountTitle')}>
        <Icon name="ri:article-line" class="text-primary/75 h-4 w-4" aria-hidden="true" />
        <span class="font-medium">{stats.postCount}</span>
        <span class="text-xs">{t(locale, 'footer.postUnit')}</span>
      </span>
    </div>

    <!-- Quick Utility Links (real routes & working back-to-top) -->
    <div class="flex flex-wrap items-center justify-center gap-1.5">
      <a href={archivesHref} class="footer-quick-link">
        <Icon name="ri:archive-2-line" class="size-3.5" aria-hidden="true" />
        <span>{t(locale, 'nav.archives')}</span>
      </a>
      <span class="text-border/80 text-xs" aria-hidden="true">·</span>
      <a href={aboutHref} class="footer-quick-link">
        <Icon name="ri:user-smile-line" class="size-3.5" aria-hidden="true" />
        <span>{t(locale, 'nav.about')}</span>
      </a>
      <span class="text-border/80 text-xs" aria-hidden="true">·</span>
      <a href="/rss.xml" class="footer-quick-link">
        <Icon name="ri:rss-line" class="size-3.5" aria-hidden="true" />
        <span>{t(locale, 'series.rss')}</span>
      </a>
      <span class="text-border/80 text-xs" aria-hidden="true">·</span>
      <button type="button" class="footer-quick-link cursor-pointer" data-footer-back-top>
        <Icon name="ri:arrow-up-line" class="size-3.5" aria-hidden="true" />
        <span>{t(locale, 'common.backToTop')}</span>
      </button>
    </div>

    <!-- Copyright -->
    <div class="text-muted-foreground flex items-center gap-0.5 text-sm">
      <span class="opacity-75">©</span>
      <span class="font-medium opacity-75">{startYear}</span>
      {
        startYear !== currentYear && (
          <>
            <span class="opacity-50">-</span>
            <span class="font-medium opacity-75" itemprop="copyrightYear">
              {currentYear}
            </span>
          </>
        )
      }
      <SakuraSVG className="mx-1 size-5 animate-spin text-[#FFC0CB] duration-10000" />
      <span class="author font-medium opacity-75" itemprop="copyrightHolder">
        {siteConfig.name}
        {siteConfig?.alternate ? `@${siteConfig.alternate}` : ''}
      </span>
    </div>

    <!-- ICP Filing -->
    {icpConfig && (
      <div class="text-muted-foreground/80 text-xs">
        {icpConfig.link ? (
          <a href={icpConfig.link} target="_blank" rel="noopener noreferrer" class="footer-link font-medium">
            {icpConfig.text}
          </a>
        ) : (
          <span class="opacity-75">{icpConfig.text}</span>
        )}
      </div>
    )}

    <!-- Powered By -->
    <div class="text-muted-foreground/80 flex flex-wrap items-center justify-center gap-2 text-xs">
      <span class="opacity-75">Powered by theme</span>
      <a
        href="https://github.com/cosZone/astro-koharu"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link font-medium transition-all duration-300"
      >
        astro-koharu
      </a>
      <span class="opacity-50">·</span>
      <span class="opacity-75">Inspired by</span>
      <a
        href="https://github.com/amehime/hexo-theme-shoka"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link font-medium transition-all duration-300"
      >
        Shoka
      </a>
    </div>
  </div>
</footer>

<script>
  import { getScrollBehavior } from '@lib/motion-level';

  function installFooterBackToTop() {
    document.querySelectorAll<HTMLButtonElement>('[data-footer-back-top]:not([data-ready])').forEach((button) => {
      button.dataset.ready = 'true';
      button.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: getScrollBehavior() });
      });
    });
  }

  installFooterBackToTop();
  document.addEventListener('astro:page-load', installFooterBackToTop);
</script>

<style>
  .footer-link {
    opacity: 0.75;
    position: relative;
  }

  .footer-link:hover {
    opacity: 1;
  }

  .footer-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: currentColor;
    transition: width 0.3s ease;
  }

  .footer-link:hover::after {
    width: 100%;
  }
</style>
