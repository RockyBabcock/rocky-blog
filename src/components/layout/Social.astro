---
import { socialConfig } from '@constants/site-config';
import { Icon } from 'astro-icon/components';

const entries = Object.entries(socialConfig);
---

{entries.length > 0 && (
  <div class="home-social flex flex-wrap items-center justify-center gap-2 pt-2">
    {entries.map(([key, item]) => (
      <a
        href={item.url}
        target={item.url.startsWith('http') ? '_blank' : undefined}
        rel={item.url.startsWith('http') ? 'noopener noreferrer' : undefined}
        aria-label={key}
        title={key}
        class="home-social-link flex size-8 items-center justify-center rounded-full bg-muted/70 text-foreground/80 transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary hover:text-white"
      >
        <Icon name={item.icon} class="size-4" />
      </a>
    ))}
  </div>
)}
