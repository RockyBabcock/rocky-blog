---
import { motionConfig, siteConfig } from '@constants/site-config';
import { translateSeriesField } from '@lib/content';
import { getPostSlug } from '@lib/content/locale';
import { getPostReadingTime } from '@lib/content/posts';
import { getEnabledSeries } from '@lib/content/series';
import { formatLocalizedDateTime } from '@lib/date';
import { getLqipStyle } from '@lib/lqip';
import { postTitleMorphName } from '@lib/morph-transitions';
import { defaultHeroImage, defaultHeroSrcset } from '@lib/responsive-image';
import { Icon } from 'astro-icon/components';
import type { BlogPost } from 'types/blog';
import { MAX_WIDTH } from '@/constants/layout';
import { getLocaleFromUrl, localizedPath, t } from '@/i18n';
import HeroImage from './HeroImage.astro';
import SakuraPetals from './SakuraPetals.astro';
import WaveSvg from './wave';

export interface CoverProps {
  data?: BlogPost;
  title?: string;
  /** Utility pages can opt into a shorter cover with a neutral loading surface. */
  compact?: boolean;
}

const { data, title, compact = false } = Astro.props as CoverProps;

const { date, updated, title: dataTitle, draft } = data?.data ?? {};

const readState = data ? getPostReadingTime(data) : null;
const isDraft = import.meta.env.DEV && draft === true;

// 获取横幅图片的 LQIP 样式
const bannerLqipStyle = compact ? undefined : getLqipStyle('/img/site_header_1920.webp');

const locale = getLocaleFromUrl(Astro.url.pathname);
const titleMorph = data ? postTitleMorphName(getPostSlug(data)) : undefined;
const copyLinkLabel = t(locale, 'cover.copyLink');
const copiedLabel = t(locale, 'common.copied');
const copyFailedLabel = t(locale, 'common.copyFailed');

const primarySeries = !title && !data ? getEnabledSeries()[0] : undefined;
const primarySeriesLabel = primarySeries
  ? translateSeriesField(
      primarySeries.slug,
      'label',
      primarySeries.label ?? primarySeries.fullName ?? primarySeries.slug,
      locale,
    )
  : '';
const primarySeriesHref = primarySeries ? localizedPath(`/${primarySeries.slug}`, locale) : '';
---

<div
  class:list={[
    'cover-hero relative z-0 flex overflow-hidden',
    compact
      ? 'h-[42svh] min-h-72 max-h-120 tablet:h-[36svh] tablet:min-h-64'
      : 'h-[58svh] min-h-96 max-h-192 md:h-[52svh] md:min-h-84',
  ]}
>
  <div class="cover-scrim absolute inset-0 h-full"></div>
  {motionConfig.heroPetals && <SakuraPetals />}
  {!compact && (
    <div class="hero-ambient-motes" aria-hidden="true">
      <svg class="celestial-hero-constellation" data-pos="top-left" viewBox="0 0 152 112" fill="none">
        <path d="M12 78C34 38 78 16 138 22" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2.5 3.5" stroke-opacity="0.45" />
        <path d="M26 30L64 46L96 24L130 52" stroke="currentColor" stroke-width="0.75" stroke-opacity="0.35" />
        <circle cx="26" cy="30" r="1.6" fill="currentColor" fill-opacity="0.75" />
        <path d="M64 40.5L65.4 44.6L69.5 46L65.4 47.4L64 51.5L62.6 47.4L58.5 46L62.6 44.6Z" fill="currentColor" fill-opacity="0.9" />
        <circle cx="96" cy="24" r="1.4" fill="currentColor" fill-opacity="0.7" />
        <circle cx="130" cy="52" r="1.2" fill="currentColor" fill-opacity="0.6" />
      </svg>
      <svg class="celestial-hero-constellation" data-pos="bottom-right" viewBox="0 0 168 104" fill="none">
        <path d="M18 86C58 84 106 58 152 18" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2.5 3.5" stroke-opacity="0.42" />
        <path d="M36 74L78 52L116 62L144 30" stroke="currentColor" stroke-width="0.75" stroke-opacity="0.34" />
        <circle cx="36" cy="74" r="1.3" fill="currentColor" fill-opacity="0.65" />
        <circle cx="78" cy="52" r="1.6" fill="currentColor" fill-opacity="0.75" />
        <path d="M116 56.5L117.3 60.7L121.5 62L117.3 63.3L116 67.5L114.7 63.3L110.5 62L114.7 60.7Z" fill="currentColor" fill-opacity="0.88" />
        <circle cx="144" cy="30" r="1.5" fill="currentColor" fill-opacity="0.7" />
      </svg>
      <span class="hero-mote hero-mote-star" style="top: 22%; left: 11%; --mote-dur: 7.4s; --mote-delay: -1.2s;" />
      <span class="hero-mote hero-mote-ring" style="top: 58%; left: 7%; --mote-dur: 8.8s; --mote-delay: -3.4s;" />
      <span class="hero-mote hero-mote-petal" style="top: 28%; right: 10%; rotate: 22deg; --mote-dur: 7.8s; --mote-delay: -2.1s;" />
      <span class="hero-mote hero-mote-star" style="top: 64%; right: 12%; --mote-dur: 6.9s; --mote-delay: -0.6s;" />
      <span class="hero-mote hero-mote-petal" style="top: 44%; right: 6%; rotate: -18deg; --mote-dur: 9.2s; --mote-delay: -4.2s;" />
    </div>
  )}
  <div
    class:list={[
      'cover-copy absolute inset-0 flex flex-col items-center justify-center px-5 text-white',
      compact ? 'bottom-[4svh]' : 'bottom-[7svh]',
    ]}
  >
    {
      title ? (
        <h1
          class:list={[
            'motion-rise shadow-text word-break flex items-center gap-2 text-center font-bold text-balance',
            MAX_WIDTH.content,
            compact
              ? 'text-4xl/[1.15] tracking-[0.08em] tablet:text-3xl/[1.15] tablet:tracking-[0.05em]'
              : 'text-5xl/[1.2] tracking-widest',
          ]}
        >
          {title}
          <button
            type="button"
            class="cover-copy-link hover:text-primary inline-flex cursor-pointer items-center rounded-full p-1 transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
            aria-label={copyLinkLabel}
            title={copyLinkLabel}
            data-copy-label={copyLinkLabel}
            data-copied-label={copiedLabel}
            data-copy-failed-label={copyFailedLabel}
          >
            <Icon name="ri:link" class={compact ? 'size-7 tablet:size-6' : undefined} aria-hidden="true" />
            <span class="sr-only" aria-live="polite"></span>
          </button>
        </h1>
      ) : data ? (
        <>
          <h1
            class={`motion-rise shadow-text word-break text-4.5xl text-center font-bold md:text-2xl ${MAX_WIDTH.content} flex flex-wrap items-center justify-center gap-3`}
            transition:name={titleMorph}
            transition:animate="initial"
            data-morph={titleMorph}
          >
            {dataTitle ?? title}
            {isDraft && (
              <span class="inline-flex items-center gap-1.5 rounded-full bg-yellow-500 px-3 py-1.5 text-base font-semibold text-white shadow-lg backdrop-blur-sm text-shadow-none hover:bg-yellow-500 md:px-2.5 md:py-1 md:text-sm">
                <Icon name="fa6-solid:file-pen" class="h-4 w-4 md:h-3.5 md:w-3.5" />
                {t(locale, 'post.draft')}
              </span>
            )}
          </h1>
          {data && (
            <p class="motion-rise cover-meta-bar mt-3.5 text-sm md:text-xs" style="--i: 1">
              <span class="cover-meta-item">
                <Icon name="fa6-solid:calendar-days" aria-hidden="true" />
                {t(locale, "post.publishedAt", { date: date ? formatLocalizedDateTime(date, locale) : '' })}
              </span>
              {updated && (
                <span class="cover-meta-item">
                  <Icon name="fa6-solid:calendar-days" aria-hidden="true" />
                  {t(locale, "post.updatedAt", { date: formatLocalizedDateTime(updated, locale) })}
                </span>
              )}
              <span class="cover-meta-item">
                <Icon name="fa6-solid:pen-nib" aria-hidden="true" />
                {t(locale, "post.wordCount", { count: readState?.words ?? 0 })}
              </span>
              <span class="cover-meta-item">
                <Icon name="fa6-solid:clock" aria-hidden="true" />
                {readState?.text}
              </span>
            </p>
          )}
        </>
      ) : (
        <>
          <p class="motion-rise shadow-text font-chill-round text-2xl/[1.2] tracking-[0.14em] opacity-95 md:text-lg">
            {siteConfig?.alternate}
          </p>
          <h1 class="motion-rise shadow-text font-chill-round mt-2 text-5.5xl/[1.15] font-bold tracking-widest md:text-3xl/[1.2]" style="--i: 1">
            {siteConfig?.title}
          </h1>
          <p class="motion-rise shadow-text hero-subtitle-ornament mt-3.5 text-center text-sm tracking-[0.16em] opacity-95 md:mt-2.5 md:text-xs md:tracking-[0.08em]" style="--i: 2">
            <span>{siteConfig?.subtitle}</span>
          </p>
          <div class="motion-rise hero-quick-actions" style="--i: 3">
            <a href="#home-content" class="hero-action-btn" data-primary="true">
              <Icon name="ri:compass-3-line" class="size-4" aria-hidden="true" />
              <span>{t(locale, 'home.heroExplore')}</span>
            </a>
            {primarySeries && (
              <a href={primarySeriesHref} class="hero-action-btn">
                <Icon name={primarySeries.icon || 'ri:newspaper-line'} class="size-4" aria-hidden="true" />
                <span>{primarySeriesLabel}</span>
              </a>
            )}
            <button type="button" class="hero-action-btn" data-hero-search-trigger>
              <Icon name="ri:search-line" class="size-4" aria-hidden="true" />
              <span>{t(locale, 'home.heroSearch')}</span>
              <kbd class="ml-0.5 rounded bg-white/15 px-1.5 py-0.5 font-mono text-[10px] leading-none md:hidden">/</kbd>
            </button>
          </div>
        </>
      )
    }
  </div>
  <div
    class:list={['relative -z-10 h-full min-h-60 w-full', compact && 'bg-card']}
    transition:persist={Astro.isPrerendered ? 'page-cover-banner' : 'page-cover-banner-runtime'}
    id="banner-box"
    style={bannerLqipStyle}
  >
    {Astro.isPrerendered ? <HeroImage
      alt=""
      class="h-full w-full object-cover"
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    /> : <img src={defaultHeroImage} srcset={defaultHeroSrcset} alt="" class="h-full w-full object-cover" width="1928" height="1080" sizes="100vw" loading="eager" fetchpriority="high" decoding="async" />}
  </div>
  <WaveSvg />
</div>

<script>
  import { readMotionLevel, subscribeMotionLevel } from '@lib/motion-level';
  import { openModal } from '@store/modal';

  /**
   * First visit only: the banner settles from a slight zoom without hiding its first paint.
   * A cached banner is painted before this module runs, so animating it would visibly jump.
   */
  function settleBanner() {
    const image = document.querySelector<HTMLImageElement>('#banner-box img');
    if (!image || image.complete || readMotionLevel() === 'reduced') return;
    image.addEventListener(
      'load',
      () => {
        if (readMotionLevel() === 'reduced') return;
        const easing = 'cubic-bezier(0.25, 1, 0.5, 1)';
        const animations = [
          image.animate({ scale: [1.08, 1] }, { duration: 1800, easing }),
        ];
        const unsubscribe = subscribeMotionLevel(() => {
          if (readMotionLevel() === 'reduced') animations.forEach((animation) => animation.cancel());
        });
        void Promise.allSettled(animations.map((animation) => animation.finished)).then(unsubscribe);
      },
      { once: true },
    );
  }

  function installCoverInteractions() {
    document.querySelectorAll<HTMLButtonElement>('[data-hero-search-trigger]:not([data-ready])').forEach((button) => {
      button.dataset.ready = 'true';
      button.addEventListener('click', () => openModal('search'));
    });

    document.querySelectorAll<HTMLButtonElement>('.cover-copy-link:not([data-copy-ready])').forEach((button) => {
      button.dataset.copyReady = 'true';
      button.addEventListener('click', async () => {
        const value = window.location.href;
        try {
          await navigator.clipboard.writeText(value);
        } catch {
          window.prompt(button.dataset.copyFailedLabel ?? button.dataset.copyLabel ?? '', value);
          return;
        }

        const status = button.querySelector<HTMLElement>('[aria-live]');
        if (status) status.textContent = button.dataset.copiedLabel ?? '';
        button.title = button.dataset.copiedLabel ?? button.title;
        window.setTimeout(() => {
          if (status) status.textContent = '';
          button.title = button.dataset.copyLabel ?? button.title;
        }, 1800);
      });
    });
  }

  settleBanner();
  installCoverInteractions();
  document.addEventListener('astro:page-load', installCoverInteractions);
</script>
