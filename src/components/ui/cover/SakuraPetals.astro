---
import { motionConfig } from '@lib/config/site';

const enabled = motionConfig.heroPetals;
---

{
  enabled && (
    <canvas
      class="sakura-petals pointer-events-none absolute inset-0 z-[2] h-full w-full"
      aria-hidden="true"
      data-sakura-petals
    />
  )
}

<script>
  import { readMotionLevel, subscribeMotionLevel } from '@lib/motion-level';
  import { computePetalCount, createPetal, drawSakuraPetal, type PetalParticle, stepPetal } from '@lib/sakura/petal-physics';

  function mountSakuraPetals() {
    const cleanups: Array<() => void> = [];

    document.querySelectorAll<HTMLCanvasElement>('canvas[data-sakura-petals]').forEach((canvas) => {
      if (canvas.dataset.petalMounted === 'true') return;
      canvas.dataset.petalMounted = 'true';

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      let width = 0;
      let height = 0;
      let petals: PetalParticle[] = [];
      let rafId = 0;
      let lastTime = 0;
      let inView = true;

      const resize = () => {
        const rect = canvas.getBoundingClientRect();
        width = Math.max(1, Math.floor(rect.width));
        height = Math.max(1, Math.floor(rect.height));
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.floor(width * dpr);
        canvas.height = Math.floor(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const targetCount = computePetalCount(width, height);
        if (petals.length === 0) {
          petals = Array.from({ length: targetCount }, () => createPetal({ width, height }, Math.random, true));
        } else if (petals.length > targetCount) {
          petals = petals.slice(0, targetCount);
        } else {
          while (petals.length < targetCount) {
            petals.push(createPetal({ width, height }, Math.random, true));
          }
        }
      };

      const stop = () => {
        if (rafId) {
          cancelAnimationFrame(rafId);
          rafId = 0;
        }
        ctx.clearRect(0, 0, width, height);
      };

      const canRun = () =>
        !document.hidden &&
        inView &&
        readMotionLevel() === 'lively' &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const tick = (now: number) => {
        if (!canRun()) {
          stop();
          return;
        }
        const dt = lastTime ? (now - lastTime) / 1000 : 0.016;
        lastTime = now;

        const isDark = document.documentElement.classList.contains('dark');
        ctx.clearRect(0, 0, width, height);
        const bounds = { width, height };
        petals = petals.map((petal) => {
          const updated = stepPetal(petal, dt, bounds);
          drawSakuraPetal(ctx, updated, isDark);
          return updated;
        });

        rafId = requestAnimationFrame(tick);
      };

      const sync = () => {
        if (canRun()) {
          if (!rafId) {
            lastTime = 0;
            rafId = requestAnimationFrame(tick);
          }
        } else {
          stop();
        }
      };

      resize();
      const resizeObserver = new ResizeObserver(resize);
      resizeObserver.observe(canvas);

      const intersectionObserver = new IntersectionObserver(
        (entries) => {
          inView = entries.some((entry) => entry.isIntersecting);
          sync();
        },
        { threshold: 0.02 },
      );
      intersectionObserver.observe(canvas);

      const onVisibilityChange = () => sync();
      document.addEventListener('visibilitychange', onVisibilityChange);
      const unsubMotion = subscribeMotionLevel(sync);

      sync();

      cleanups.push(() => {
        stop();
        resizeObserver.disconnect();
        intersectionObserver.disconnect();
        document.removeEventListener('visibilitychange', onVisibilityChange);
        unsubMotion();
        delete canvas.dataset.petalMounted;
      });
    });

    return () => {
      for (const cleanup of cleanups) cleanup();
    };
  }

  let teardown: (() => void) | null = null;
  const init = () => {
    teardown?.();
    teardown = mountSakuraPetals();
  };

  if (document.readyState !== 'loading') init();
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    teardown?.();
    teardown = null;
  });
</script>
