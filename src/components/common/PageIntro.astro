---
import EditorialKicker, { type EditorialKickerVariant } from '@components/common/EditorialKicker.astro';
import { cn } from '@lib/utils';

interface Props {
  stats: { value: string | number; label: string; labelFirst?: boolean }[];
  breadcrumbs?: { label: string; href?: string }[];
  description?: string;
  kicker?: { label: string; variant?: EditorialKickerVariant };
  className?: string;
}
const { stats, breadcrumbs = [], description, kicker, className } = Astro.props;
---
<header class={cn('page-intro', className)}>
  {kicker && (
    <div class="w-full">
      <EditorialKicker label={kicker.label} variant={kicker.variant ?? 'ruled'} className="mb-0" />
    </div>
  )}
  {breadcrumbs.length > 0 && <nav class="page-crumbs" aria-label={breadcrumbs[0].label}>
    {breadcrumbs.map((crumb) => crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>)}
  </nav>}
  {description && <p class="mt-2 max-w-2xl text-sm text-muted-foreground leading-relaxed">{description}</p>}
  <p class="page-summary">
    {stats.map(({ value, label, labelFirst }) => <span>{labelFirst ? <>{label} <b>{value}</b></> : <><b>{value}</b> {label}</>}</span>)}
  </p>
  {Astro.slots.has('tools') && <div class="page-intro-tools"><slot name="tools" /></div>}
</header>
