---
import ContentEnhancer from '@components/markdown/ContentEnhancer';
import type { ContentConfig } from '@constants/content-config';
import { defaultContentConfig } from '@constants/content-config';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import { getLocaleFromUrl, t } from '@/i18n';

interface Props {
  Content?: AstroComponentFactory;
  config?: Partial<ContentConfig>;
}

const { Content, config = {} } = Astro.props;
const finalConfig = { ...defaultContentConfig, ...config };
const spoilerRevealLabel = t(getLocaleFromUrl(Astro.url.pathname), 'content.revealSpoiler');
---

<div
  class="custom-content motion-reveal-lively"
  data-config={JSON.stringify(finalConfig)}
  data-spoiler-reveal-label={spoilerRevealLabel}
>
  {Content ? <Content /> : <slot />}
</div>

{/* React-based content enhancement (code blocks, mermaid, infographic toolbars) */}
{finalConfig.enhanceCodeBlock && (
  <ContentEnhancer
    client:content
    enableCopy={finalConfig.enableCodeCopy}
    enableFullscreen={finalConfig.enableCodeFullscreen}
    enableEncryptedBlock={finalConfig.enableEncryptedBlock}
  />
)}

<script>
  import { getScrollBehavior } from '@lib/motion-level';
  import { enhanceImages } from '@lib/image-enhancer';
  import { enhanceSpoilers } from '@lib/spoiler-enhancer';

  function bindDelegatedClickHandlers(contentContainer: HTMLElement, smoothScroll: boolean) {
    if (contentContainer.dataset.listenersBound === 'true') return;
    contentContainer.dataset.listenersBound = 'true';

    contentContainer.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      // Smooth scroll for heading anchor links
      if (smoothScroll) {
        const anchor = target.closest<HTMLAnchorElement>('a.anchor-link[href^="#"]');
        if (anchor && contentContainer.contains(anchor)) {
          event.preventDefault();
          const targetId = anchor.getAttribute('href')?.substring(1);
          if (!targetId) return;
          const targetElement = document.getElementById(targetId);
          if (targetElement) {
            targetElement.scrollIntoView({ behavior: getScrollBehavior(), block: 'start' });
            history.pushState(null, '', `#${targetId}`);
          }
          return;
        }
      }

      // Tab group switching logic
      const tabHeader = target.closest<HTMLElement>('.tab-header[role="tab"]');
      if (tabHeader && contentContainer.contains(tabHeader)) {
        const groupId = tabHeader.dataset.tabGroup;
        const tabIndex = tabHeader.dataset.tabIndex;
        if (!groupId || tabIndex === undefined) return;

        const group = contentContainer.querySelector(`.tab-group[data-tab-group="${groupId}"]`);
        if (!group) return;

        group.querySelectorAll<HTMLElement>('.tab-header').forEach((header) => {
          header.setAttribute('aria-selected', String(header.dataset.tabIndex === tabIndex));
        });

        group.querySelectorAll<HTMLElement>('.tab-panel').forEach((panel) => {
          panel.classList.toggle('active', panel.dataset.tabIndex === tabIndex);
        });
        return;
      }

      // Blur spoiler click-to-reveal (default spoilers handled by spoilerjs)
      const blurSpoiler = target.closest<HTMLElement>('.spoiler.blur');
      if (blurSpoiler && contentContainer.contains(blurSpoiler)) {
        blurSpoiler.classList.toggle('revealed');
      }
    });
  }

  // Content enhancement script - handles non-React enhancements
  function enhanceContent() {
    const contentContainer = document.querySelector<HTMLElement>('.custom-content');
    if (!contentContainer) return;

    // Keep this outside the general enhancement guard so a transient module-load
    // failure can retry without registering the other handlers again.
    enhanceSpoilers(contentContainer);

    // Avoid re-enhancing DOM attributes/images on duplicate runs
    if (contentContainer.getAttribute('data-enhanced') === 'true') return;

    // Get configuration from data attribute
    const configData = contentContainer.getAttribute('data-config');
    const config = configData
      ? JSON.parse(configData)
      : { addBlankTarget: true, smoothScroll: true, addHeadingLevel: true };

    // Bind delegated interactive handlers once per container element (also covers decrypted DOM)
    bindDelegatedClickHandlers(contentContainer, Boolean(config.smoothScroll));

    // Add target="_blank" to external links
    if (config.addBlankTarget) {
      const links = contentContainer.querySelectorAll('a[href]');
      links.forEach((link: Element) => {
        const anchor = link as HTMLAnchorElement;
        const href = anchor.getAttribute('href') || '';
        if (href.startsWith('http') || href.startsWith('//')) {
          anchor.setAttribute('target', '_blank');
        }
      });
    }

    // Add heading level labels (H1, H2, etc.)
    if (config.addHeadingLevel) {
      const headings = contentContainer.querySelectorAll('h1, h2, h3, h4, h5, h6');
      headings.forEach((heading: Element) => {
        const level = heading.tagName[1];
        heading.setAttribute('data-level', `H${level}`);
      });
    }

    // Enhance images with loading states
    enhanceImages(contentContainer);

    // Mark as enhanced
    contentContainer.setAttribute('data-enhanced', 'true');
  }

  // Run on page load
  document.addEventListener('astro:page-load', () => {
    const contentContainer = document.querySelector('.custom-content');
    if (contentContainer) {
      contentContainer.removeAttribute('data-enhanced');
    }
    enhanceContent();
  });

  // Re-enhance after encrypted post decryption (new DOM needs external links, headings, images, etc.)
  document.addEventListener('content:decrypted', () => {
    const contentContainer = document.querySelector('.custom-content');
    if (contentContainer) {
      contentContainer.removeAttribute('data-enhanced');
    }
    enhanceContent();
  });

  // Run immediately if already loaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', enhanceContent);
  } else {
    enhanceContent();
  }
</script>
