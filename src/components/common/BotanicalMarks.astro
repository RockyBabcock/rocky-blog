---
/**
 * BotanicalMarks — Mature, minimalist botanical sakura & celestial line-art ornaments.
 *
 * Strictly editorial and studio-crafted: single-weight hairlines, natural silhouettes,
 * subtle geometry, zero cartoonish or anime/kawaii styling.
 */

export type BotanicalMarkVariant =
  | 'divider-sakura'
  | 'divider-celestial'
  | 'watermark-branch'
  | 'hero-celestial'
  | 'footer-emblem';

interface Props {
  variant: BotanicalMarkVariant;
  className?: string;
}

const { variant, className = '' } = Astro.props;
---

{
  variant === 'divider-sakura' && (
    <svg
      class:list={['editorial-ornament-svg editorial-ornament-sakura', className]}
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.35"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 12c-1.8-2.4-2.1-5.8-.7-7.8l.7 1.3.7-1.3c1.4 2 1.1 5.4-.7 7.8Z" />
      <path d="M12 12c2.8-.6 5.8.7 7.1 2.7l-1.5.2.9 1.2c-2.3.5-5.3-.9-6.5-4.1Z" />
      <path d="M12 12c1.2 2.8.6 6-1.1 7.6l-.4-1.5-1.1 1.1c-.9-2.2-.3-5.3 2.6-7.2Z" />
      <path d="M12 12c-2.8-.6-5.8.7-7.1 2.7l1.5.2-.9 1.2c2.3.5 5.3-.9 6.5-4.1Z" />
      <path d="M12 12c-1.2 2.8-.6 6 1.1 7.6l.4-1.5 1.1 1.1c.9-2.2.3-5.3-2.6-7.2Z" opacity="0.55" />
      <circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none" />
    </svg>
  )
}

{
  variant === 'divider-celestial' && (
    <svg
      class:list={['editorial-ornament-svg editorial-ornament-celestial', className]}
      width="32"
      height="14"
      viewBox="0 0 32 14"
      fill="none"
      aria-hidden="true"
    >
      <circle cx="5" cy="7" r="1" fill="currentColor" opacity="0.55" />
      <path
        d="M16 1.75L17.15 5.85L21.25 7L17.15 8.15L16 12.25L14.85 8.15L10.75 7L14.85 5.85L16 1.75Z"
        stroke="currentColor"
        stroke-width="1.1"
        stroke-linejoin="round"
      />
      <circle cx="27" cy="7" r="1" fill="currentColor" opacity="0.55" />
    </svg>
  )
}

{
  variant === 'watermark-branch' && (
    <svg
      class:list={['editorial-watermark-svg', className]}
      width="124"
      height="124"
      viewBox="0 0 140 140"
      fill="none"
      stroke="currentColor"
      stroke-width="1"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      {/* Minimal botanical branch arc */}
      <path d="M138 18C104 34 78 62 56 104" />
      <path d="M98 44C82 40 66 44 50 54" opacity="0.7" />
      <path d="M77 69C88 76 98 86 106 100" opacity="0.65" />
      {/* Single natural sakura blossom line-art */}
      <g transform="translate(88 42) rotate(-14)">
        <path d="M0 0c-3.5-5-4-11-1.3-15l1.3 2.5 1.3-2.5c2.7 4 2.2 10-1.3 15Z" />
        <path d="M0 0c5.5-1.2 11 1.4 13.8 5.2l-2.9.4 1.7 2.3C8.2 8.8 2.4 6 0 0Z" />
        <path d="M0 0c-5.5-1.2-11 1.4-13.8 5.2l2.9.4-1.7 2.3C-8.2 8.8-2.4 6 0 0Z" />
        <path d="M0 0c2.2 5.4 1 11.4-2.1 14.5l-.8-2.8-2.1 2C-6.7 9.5-5.4 3.6 0 0Z" />
        <path d="M0 0c-2.2 5.4-1 11.4 2.1 14.5l.8-2.8 2.1 2C6.7 9.5 5.4 3.6 0 0Z" opacity="0.65" />
        <circle cx="0" cy="0" r="1.6" fill="currentColor" stroke="none" />
      </g>
      {/* Delicate drifting petal & celestial point */}
      <path d="M40 78c-3.2 2.4-6.4 3.4-9.2 2.6 1-2.8 2.8-5.4 6-7.6 1.5-.9 2.6-.7 3.2.5.6 1.3.7 3 0 4.5Z" opacity="0.7" />
      <path d="M114 114l.9 2.6 2.6.9-2.6.9-.9 2.6-.9-2.6-2.6-.9 2.6-.9.9-2.6Z" fill="currentColor" stroke="none" opacity="0.55" />
      <circle cx="34" cy="40" r="1.1" fill="currentColor" stroke="none" opacity="0.45" />
    </svg>
  )
}

{
  variant === 'hero-celestial' && (
    <div class:list={['hero-celestial-frame pointer-events-none absolute inset-0 z-[1] overflow-hidden', className]} aria-hidden="true">
      {/* Upper-left quiet constellation arc */}
      <svg
        class="hero-celestial-arc hero-celestial-arc--left"
        width="260"
        height="180"
        viewBox="0 0 260 180"
        fill="none"
      >
        <path d="M-24 140A170 170 0 0 1 182 -14" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 5" opacity="0.38" />
        <path d="M36 74L92 52L144 68" stroke="currentColor" stroke-width="0.65" opacity="0.3" />
        <circle cx="36" cy="74" r="1.5" fill="currentColor" opacity="0.65" />
        <circle cx="92" cy="52" r="2" fill="currentColor" opacity="0.8" />
        <circle cx="144" cy="68" r="1.3" fill="currentColor" opacity="0.55" />
        <path d="M92 44l1.1 5.9 5.9 1.1-5.9 1.1L92 58l-1.1-5.9-5.9-1.1 5.9-1.1L92 44Z" fill="currentColor" opacity="0.55" />
      </svg>

      {/* Upper-right delicate celestial coordinate & hairline arc */}
      <svg
        class="hero-celestial-arc hero-celestial-arc--right"
        width="260"
        height="180"
        viewBox="0 0 260 180"
        fill="none"
      >
        <path d="M284 148A176 176 0 0 0 74 -16" stroke="currentColor" stroke-width="0.75" opacity="0.32" />
        <path d="M126 58L182 44L224 78" stroke="currentColor" stroke-width="0.65" opacity="0.28" />
        <circle cx="126" cy="58" r="1.3" fill="currentColor" opacity="0.55" />
        <circle cx="182" cy="44" r="1.8" fill="currentColor" opacity="0.75" />
        <circle cx="224" cy="78" r="1.4" fill="currentColor" opacity="0.6" />
        <path d="M182 37l.9 5.1 5.1.9-5.1.9-.9 5.1-.9-5.1-5.1-.9 5.1-.9.9-5.1Z" fill="currentColor" opacity="0.5" />
      </svg>
    </div>
  )
}

{
  variant === 'footer-emblem' && (
    <svg
      class:list={['editorial-ornament-svg editorial-footer-emblem', className]}
      width="44"
      height="16"
      viewBox="0 0 44 16"
      fill="none"
      aria-hidden="true"
    >
      <circle cx="6" cy="8" r="1" fill="currentColor" opacity="0.5" />
      <path d="M10 8h5" stroke="currentColor" stroke-width="0.9" opacity="0.4" />
      <g transform="translate(22 8)" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round">
        <path d="M0 0c-1.2-1.8-1.4-4.2-.4-5.6l.4.9.4-.9c1 1.4.8 3.8-.4 5.6Z" />
        <path d="M0 0c2-.4 4.1.5 5 1.9l-1 .1.6.9C3 3.3.9 2.3 0 0Z" />
        <path d="M0 0c-2-.4-4.1.5-5 1.9l1 .1-.6.9C-3 3.3-.9 2.3 0 0Z" />
        <path d="M0 0c.8 2 .4 4.2-.8 5.3l-.3-1-.8.8C-2.5 3.6-2 1.4 0 0Z" />
        <path d="M0 0c-.8 2-.4 4.2.8 5.3l.3-1 .8.8C2.5 3.6 2 1.4 0 0Z" opacity="0.6" />
        <circle cx="0" cy="0" r="0.9" fill="currentColor" stroke="none" />
      </g>
      <path d="M29 8h5" stroke="currentColor" stroke-width="0.9" opacity="0.4" />
      <circle cx="38" cy="8" r="1" fill="currentColor" opacity="0.5" />
    </svg>
  )
}
