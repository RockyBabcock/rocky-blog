---
/**
 * EditorialKicker — Disciplined Swiss-editorial section indexer.
 * Supports 3 crisp typographic modes without floral or celestial motifs.
 */

export type EditorialKickerVariant = 'numbered' | 'ruled' | 'minimal';

interface Props {
  label: string;
  number?: string;
  variant?: EditorialKickerVariant;
  className?: string;
}

const { label, number, variant = 'numbered', className = '' } = Astro.props;
---

<div class:list={['editorial-kicker', className]} data-style={variant} aria-hidden="true">
  {variant === 'numbered' && (
    <>
      {number && (
        <>
          <span class="editorial-kicker-num">{number}</span>
          <span class="editorial-kicker-sep">/</span>
        </>
      )}
      <span>{label}</span>
    </>
  )}

  {variant === 'ruled' && (
    <>
      <span class="editorial-kicker-rule" />
      {number && <span class="editorial-kicker-num">{number}</span>}
      <span>{label}</span>
    </>
  )}

  {variant === 'minimal' && (
    <>
      <span class="editorial-kicker-dot" />
      <span>{label}</span>
    </>
  )}
</div>
