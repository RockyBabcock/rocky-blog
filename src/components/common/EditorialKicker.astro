---
/**
 * EditorialKicker — Art-directed section kicker with 5 distinct editorial modes
 * uniting Sakura Editorial, Celestial Details, and Magazine Graphic Design so
 * sections feel curated rather than repeating one identical header template.
 */

export type EditorialKickerVariant = 'sakura-star' | 'magazine' | 'constellation' | 'geometric' | 'orbital';

interface Props {
  label: string;
  number?: string;
  variant?: EditorialKickerVariant;
  className?: string;
}

const { label, number, variant = 'sakura-star', className = '' } = Astro.props;
---

<div class:list={['editorial-kicker', className]} data-style={variant} aria-hidden="true">
  {variant === 'sakura-star' && (
    <>
      {number && <span class="editorial-kicker-num">{number}</span>}
      <span class="editorial-kicker-petal" />
      <span class="editorial-kicker-rule" />
      <span>{label}</span>
      <span class="celestial-star celestial-star-sm" />
    </>
  )}

  {variant === 'magazine' && (
    <>
      {number && <span class="editorial-kicker-num">{number}</span>}
      <span class="editorial-kicker-rule" />
      <span>{label}</span>
    </>
  )}

  {variant === 'constellation' && (
    <>
      {number && <span class="editorial-kicker-num">{number}</span>}
      <svg class="editorial-kicker-svg h-3 w-9 text-primary/70" viewBox="0 0 36 12" fill="none">
        <path d="M3 8.5L15 3.5L26 7.5L33 4" stroke="currentColor" stroke-width="0.9" stroke-opacity="0.45" />
        <circle cx="3" cy="8.5" r="1.4" fill="currentColor" fill-opacity="0.7" />
        <path d="M15 0.8L15.7 2.8L17.7 3.5L15.7 4.2L15 6.2L14.3 4.2L12.3 3.5L14.3 2.8Z" fill="currentColor" />
        <circle cx="26" cy="7.5" r="1.3" fill="currentColor" fill-opacity="0.65" />
        <circle cx="33" cy="4" r="1.1" fill="currentColor" fill-opacity="0.55" />
      </svg>
      <span>{label}</span>
    </>
  )}

  {variant === 'geometric' && (
    <>
      <span class="editorial-ornament-diamond" />
      {number && <span class="editorial-kicker-num">{number}</span>}
      <span class="editorial-kicker-rule" />
      <span>{label}</span>
    </>
  )}

  {variant === 'orbital' && (
    <>
      <svg class="editorial-kicker-svg h-3.5 w-6 text-primary/75" viewBox="0 0 24 14" fill="none">
        <path d="M2 10.5C6.5 2.5 17.5 2.5 22 10.5" stroke="currentColor" stroke-width="1" stroke-dasharray="2 2" stroke-opacity="0.55" />
        <path d="M12 1.5L12.7 3.3L14.5 4L12.7 4.7L12 6.5L11.3 4.7L9.5 4L11.3 3.3Z" fill="currentColor" />
      </svg>
      {number && <span class="editorial-kicker-num">{number}</span>}
      <span class="editorial-kicker-rule" />
      <span>{label}</span>
    </>
  )}
</div>
