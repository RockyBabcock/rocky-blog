---
import Divider from '@components/ui/Divider.astro';
import type { BlogPost } from 'types/blog';
import PostCard from './PostCard.astro';

interface Props {
  posts: BlogPost[];
  title?: string;
  locale?: string;
  startIndex?: number;
}

const { posts, title, locale, startIndex = 0 } = Astro.props;
---

{posts.length > 0 && (
  <section class="flex flex-col gap-5">
    {title && <Divider>{title}</Divider>}
    <div class="flex flex-col gap-5">
      {posts.map((post, idx) => (
        <PostCard post={post} index={startIndex + idx} locale={locale} />
      ))}
    </div>
  </section>
)}
