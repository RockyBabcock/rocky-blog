---
import { Routes } from '@constants/router';
import { getPostSlug, getSortedPosts, translateCategoryName } from '@lib/content';
import { getRelatedPosts, hasSimilarityData } from '@lib/content/similarities';
import { toPostRefWithCategory } from '@lib/content/transforms';
import { routeBuilder } from '@lib/route';
import type { BlogPost } from 'types/blog';
import { getLocaleFromUrl, localizedPath, t } from '@/i18n';

interface Props {
  post?: BlogPost;
}

const { post } = Astro.props;
const locale = getLocaleFromUrl(Astro.url.pathname);
const allPosts = await getSortedPosts(locale);

const currentSlug = post ? getPostSlug(post) : null;
const relatedPosts = hasSimilarityData() && post ? getRelatedPosts(post, allPosts, 5).map(toPostRefWithCategory) : [];

const isRelated = relatedPosts.length > 0;
const displayPosts = isRelated
  ? relatedPosts
  : allPosts
      .filter((candidate) => (currentSlug ? getPostSlug(candidate) !== currentSlug : true))
      .slice(0, 5)
      .map(toPostRefWithCategory);

const heading = t(locale, isRelated ? 'post.relatedPosts' : 'post.latestPosts');
---

{
  displayPosts.length > 0 && (
    <section class="motion-reveal flex flex-col gap-4 px-10 md:px-6" aria-label={heading}>
      <h2 class="text-foreground/80 text-xl font-semibold">{heading}</h2>
      <ol class="tablet:grid-cols-1 grid grid-cols-2 gap-x-6 gap-y-2">
        {displayPosts.map((item, index) => {
          const href = localizedPath(routeBuilder(Routes.Post, item), locale);
          const categoryLabel = item.categoryName ? translateCategoryName(item.categoryName, locale) : '';
          return (
            <li>
              <a
                href={href}
                class="group text-foreground/80 hover:bg-foreground/5 hover:text-primary flex items-center gap-3 rounded-lg px-3 py-2 transition-colors duration-200"
              >
                <span class="text-muted-foreground/70 group-hover:text-primary w-5 shrink-0 text-right font-mono text-sm font-medium transition-colors duration-200">
                  {index + 1}
                </span>
                <div class="flex min-w-0 flex-1 flex-col gap-0.5">
                  {categoryLabel && <span class="text-muted-foreground truncate text-xs">{categoryLabel}</span>}
                  <span class="truncate text-sm font-medium">{item.title}</span>
                </div>
              </a>
            </li>
          );
        })}
      </ol>
    </section>
  )
}
