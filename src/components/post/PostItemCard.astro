---
/**
 * PostItemCard — Contemporary Editorial horizontal article card.
 *
 * Replaces dated diagonal clip-paths and overhanging English "more..." corners with a
 * clean 42%/58% framed composition, crisp typographic metadata, 2-line titles, subdued
 * tag links, and localized inline read-more footer.
 */
import ResponsiveImage from '@components/common/ResponsiveImage.astro';
import BookmarkToggleButton from '@components/post/BookmarkToggleButton.astro';
import { Badge } from '@components/ui/badge';
import { ScrollableRow } from '@components/ui/ScrollableRow';
import { Routes } from '@constants/router';
import { defaultCoverList } from '@constants/site-config';
import { buildCategoryPath, buildTagPath, getCategoryArr, translateCategoryName } from '@lib/content';
import { formatLocalizedDate } from '@lib/date';
import { getLqipProps } from '@lib/lqip';
import { postTitleMorphName } from '@lib/morph-transitions';
import { routeBuilder } from '@lib/route';
import { cn } from '@lib/utils';
import { Icon } from 'astro-icon/components';
import { defaultLocale, getLocaleFromUrl, getLocaleLabel, localizedPath, t } from '@/i18n';
import type { PostCardData } from '@/types/blog';

export interface PostItemCardProps {
  data: PostCardData;
  leftClip?: boolean;
  randomCover: string;
  isUniformPosition?: boolean;
}

const { randomCover, data, leftClip = true, isUniformPosition = false } = Astro.props as PostItemCardProps;

const { cover, date, categories, title, draft, description, slug, link, tags, wordCount, readingTime, postLocale } = data ?? {};

const locale = getLocaleFromUrl(Astro.url.pathname);
const finalCover = cover ?? randomCover ?? defaultCoverList[0];
const href = localizedPath(routeBuilder(Routes.Post, { slug, link, title }), locale);
const isDraft = import.meta.env.DEV && draft === true;
const isFallback = postLocale != null && locale !== defaultLocale && postLocale !== locale;

const categoryArr = getCategoryArr(categories?.[0]);
const categoryLink = localizedPath(buildCategoryPath(categoryArr), locale);
const categoryStr = categoryArr?.length ? translateCategoryName(categoryArr[categoryArr.length - 1], locale) : '';

const postDescription = description ?? '';
const lqipProps = getLqipProps(finalCover);
const titleMorph = postTitleMorphName(slug);
const imageOnLeft = isUniformPosition ? true : leftClip;
---

<article
  class={cn(
    'post-item-card motion-reveal group text-card-foreground border-border hover:border-primary/45 relative flex overflow-hidden rounded-[0.875rem] border bg-card md:flex-col',
  )}
>
  <a
    href={href}
    tabindex="-1"
    aria-hidden="true"
    style={lqipProps.style}
    class={cn(
      'post-item-cover relative min-h-48 w-[42%] shrink-0 overflow-hidden md:h-46 md:min-h-0 md:w-full',
      imageOnLeft ? 'order-1 border-r border-border/60 md:border-r-0 md:border-b' : 'order-2 border-l border-border/60 md:border-l-0 md:border-b',
      'md:order-0',
      lqipProps.class,
    )}
  >
    <ResponsiveImage
      src={finalCover}
      maxWidth={800}
      sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 992px) 42vw, 360px"
      loading="lazy"
      decoding="async"
      alt=""
      class="h-full w-full cursor-pointer object-cover"
    />
    <span class="pointer-events-none absolute inset-0 ring-1 ring-inset ring-black/6 dark:ring-white/8" aria-hidden="true" />
  </a>

  <div
    class={cn(
      'flex min-w-0 flex-1 flex-col justify-between gap-2.5 p-5 md:p-4',
      imageOnLeft ? 'order-2' : 'order-1',
      'md:order-0',
    )}
  >
    <div class="flex flex-col gap-2">
      {/* Unboxed editorial metadata row + bookmark */}
      <div class="flex items-start justify-between gap-2">
        <div class="text-muted-foreground flex min-w-0 flex-wrap items-center gap-x-1.5 gap-y-0.5 text-xs">
          {categoryStr && (
            <a
              href={categoryLink}
              class="text-primary hover:text-blue shrink-0 font-medium whitespace-nowrap transition-colors"
            >
              {categoryStr}
            </a>
          )}
          {categoryStr && date && (
            <span class="text-muted-foreground/45 select-none" aria-hidden="true">·</span>
          )}
          {date && (
            <time datetime={date.toISOString()} class="font-mono text-[11px] whitespace-nowrap tabular-nums">
              {formatLocalizedDate(date, locale)}
            </time>
          )}
          <span class="text-muted-foreground/45 select-none md:hidden" aria-hidden="true">·</span>
          <span class="whitespace-nowrap tabular-nums md:hidden">
            {t(locale, 'post.wordCount', { count: wordCount })}
          </span>
          <span class="text-muted-foreground/45 select-none md:hidden" aria-hidden="true">·</span>
          <span
            class="inline-flex items-center gap-1 whitespace-nowrap tabular-nums md:hidden"
            title={t(locale, 'post.readingTimeTooltip', { time: readingTime })}
          >
            <Icon name="fa6-solid:clock" class="size-3 opacity-75" aria-hidden="true" />
            {readingTime}
          </span>
        </div>

        <BookmarkToggleButton
          variant="subtle"
          slug={slug}
          title={title}
          url={href}
          locale={locale}
          category={categoryStr || undefined}
          description={postDescription || undefined}
          cover={finalCover}
          publishedAt={date ? formatLocalizedDate(date, locale) : undefined}
          readingTime={readingTime}
          className="shrink-0"
        />
      </div>

      {/* Article title + optional status badges */}
      <div class="flex flex-wrap items-center gap-2">
        <a href={href} class="min-w-0 flex-1 outline-none">
          <h2
            class="text-foreground group-hover:text-primary line-clamp-2 text-lg leading-snug font-bold tracking-tight transition-colors duration-200 md:text-base"
            transition:name={titleMorph}
            transition:animate="initial"
            data-morph={titleMorph}
          >
            {title}
          </h2>
        </a>
        {isDraft && (
          <Badge className="shrink-0 gap-1 border border-yellow-600/20 bg-yellow-700 whitespace-nowrap text-white hover:bg-yellow-600">
            <Icon name="fa6-solid:file-pen" class="h-3 w-3" />
            {t(locale, 'post.draft')}
          </Badge>
        )}
        {isFallback && (
          <Badge className="shrink-0 gap-1 border-amber-500/30 bg-amber-500/10 whitespace-nowrap text-amber-700 dark:text-amber-400">
            <Icon name="ri:translate-2" class="h-3 w-3" />
            {getLocaleLabel(postLocale ?? defaultLocale)}
          </Badge>
        )}
      </div>

      {/* Excerpt */}
      {postDescription && (
        <p class="text-muted-foreground line-clamp-2 text-sm leading-relaxed md:text-xs">
          {postDescription}
        </p>
      )}
    </div>

    {/* Editorial footer hairline: subdued tags + localized read-more link */}
    <div class="border-border/60 mt-1 flex items-center justify-between gap-3 border-t pt-2.5">
      <div class="min-w-0 flex-1">
        {tags?.length ? (
          <ScrollableRow client:visible className="w-full" innerClassName="gap-2.5 items-center" fadeWidth={14}>
            {tags.slice(0, 4).map((tag: string) => (
              <a
                href={localizedPath(buildTagPath(tag), locale)}
                class="text-muted-foreground hover:text-primary shrink-0 text-xs whitespace-nowrap transition-colors"
              >
                <span class="text-primary/65 mr-0.5">#</span>
                {tag}
              </a>
            ))}
          </ScrollableRow>
        ) : (
          <span class="text-muted-foreground/70 hidden items-center gap-1 text-xs tabular-nums md:inline-flex">
            <Icon name="fa6-solid:clock" class="size-3" aria-hidden="true" />
            {readingTime}
          </span>
        )}
      </div>

      <a
        href={href}
        class="text-primary hover:text-blue inline-flex shrink-0 items-center gap-1 text-xs font-semibold whitespace-nowrap transition-colors"
      >
        <span>{t(locale, 'post.readMore')}</span>
        <Icon
          name="ri:arrow-right-line"
          class="post-item-arrow size-3.5 transition-transform duration-200 group-hover:translate-x-0.5"
          aria-hidden="true"
        />
      </a>
    </div>
  </div>
</article>

<style>
  .post-item-card {
    content-visibility: auto;
    contain-intrinsic-size: auto 216px;
    box-shadow: var(--ed-surface-shadow);
    transition:
      transform 220ms var(--ease-out-quart),
      box-shadow 220ms var(--ease-out-quart),
      border-color 220ms var(--ease-out-quart);
  }

  .post-item-card:has(a:focus-visible) {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 3px;
  }

  .post-item-cover img {
    transition: scale 520ms var(--ease-out-quart);
  }

  @media (hover: hover) {
    .post-item-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--ed-surface-shadow-hover);
    }

    .post-item-card:hover .post-item-cover img {
      scale: 1.035;
    }
  }

  :global(html:is([data-motion="reduced"], .motion-off)) .post-item-card,
  :global(html:is([data-motion="reduced"], .motion-off)) .post-item-cover img,
  :global(html:is([data-motion="reduced"], .motion-off)) .post-item-arrow {
    transition: none;
    transform: none;
    scale: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-item-card,
    .post-item-cover img,
    .post-item-arrow {
      transition: none;
      transform: none;
      scale: none;
    }
  }
</style>
