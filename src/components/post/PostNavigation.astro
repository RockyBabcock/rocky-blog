---
import { getPostSlug } from '@lib/content';
import { Icon } from 'astro-icon/components';
import type { BlogPost } from 'types/blog';
import { localizedPath, t } from '@/i18n';

interface Props {
  prevPost?: BlogPost | null;
  nextPost?: BlogPost | null;
  locale?: string;
}

const { prevPost, nextPost, locale } = Astro.props;
---

{(prevPost || nextPost) && (
  <nav
    class="mt-8 grid grid-cols-2 gap-4 border-t border-border/70 pt-6 md:grid-cols-1"
    aria-label="Post navigation"
  >
    {prevPost ? (
      <a
        href={localizedPath(`/post/${getPostSlug(prevPost)}`, locale)}
        class="group flex flex-col gap-1 rounded-xl border border-border/70 bg-card/70 p-4 transition-all hover:border-primary/40 hover:bg-card"
      >
        <span class="inline-flex items-center gap-1 text-xs text-muted-foreground">
          <Icon name="ri:arrow-left-line" class="h-3.5 w-3.5 transition-transform group-hover:-translate-x-0.5" />
          {t(locale, 'post.prev')}
        </span>
        <span class="line-clamp-1 font-semibold text-sm text-foreground transition-colors group-hover:text-primary">
          {prevPost.data.title}
        </span>
      </a>
    ) : (
      <div />
    )}

    {nextPost ? (
      <a
        href={localizedPath(`/post/${getPostSlug(nextPost)}`, locale)}
        class="group flex flex-col items-end gap-1 rounded-xl border border-border/70 bg-card/70 p-4 text-right transition-all hover:border-primary/40 hover:bg-card"
      >
        <span class="inline-flex items-center gap-1 text-xs text-muted-foreground">
          {t(locale, 'post.next')}
          <Icon name="ri:arrow-right-line" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
        </span>
        <span class="line-clamp-1 font-semibold text-sm text-foreground transition-colors group-hover:text-primary">
          {nextPost.data.title}
        </span>
      </a>
    ) : (
      <div />
    )}
  </nav>
)}
