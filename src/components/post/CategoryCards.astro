---
import { categoryMap } from '@constants/category';
import { Routes } from '@constants/router';
import { siteConfig } from '@constants/site-config';
import {
  type Category,
  getCategoryByLink,
  getCategoryList,
  getParentCategory,
  getPostsByCategory,
  translateCategoryName,
} from '@lib/content';
import { translateFeaturedCategoryField } from '@lib/content/categories';
import { toPostRefs } from '@lib/content/transforms';
import { getLqipStyle } from '@lib/lqip';
import { routeBuilder } from '@lib/route';
import { Icon } from 'astro-icon/components';
import { getLocaleFromUrl, localizedPath, t } from '@/i18n';
import type { PostRef } from '@/types/blog';
import FlippedCard from './FlippedCard.astro';

interface CategoryWithPosts {
  link: string;
  label?: string;
  description?: string;
  image: string;
  posts: PostRef[];
  category: Category | null;
  parentCategory: Category | null;
}

const locale = getLocaleFromUrl(Astro.url.pathname);
const { categories } = await getCategoryList(locale);

const categoryPosts: CategoryWithPosts[] = (
  await Promise.all(
    siteConfig.featuredCategories?.map(async (category) => {
      const categoryInfo = getCategoryByLink(categories, category?.link);
      const posts = await getPostsByCategory(categoryInfo?.name ?? '', locale);
      return {
        link: category.link,
        label: category?.label,
        description: category?.description,
        image: category.image,
        category: categoryInfo,
        parentCategory: getParentCategory(categoryInfo, categories),
        posts: toPostRefs(posts),
      };
    }) || [],
  )
).filter((item) => item.posts.length > 0);
---

<div class="grid w-full grid-cols-2 gap-4 md:grid-cols-1">
  {
    categoryPosts.map((category, idx) => {
      const parentCategory = category?.parentCategory;
      const parentCategoryLink = parentCategory
        ? localizedPath(Routes.Categories + '/' + (category?.link.split('/').slice(0, -1).join('/') ?? ''), locale)
        : '';
      const categoryInfo = category?.category;
      const categoryLink = localizedPath(Routes.Categories + '/' + (category?.link ?? ''), locale);
      const childrenLen = categoryInfo?.children?.length ?? 0;
      const posts = category?.posts?.slice(0, Math.max(2, 6 - childrenLen));
      const fallbackLabel = translateCategoryName(category?.label ?? categoryInfo?.name ?? '', locale);
      const displayName = translateFeaturedCategoryField(category.link, 'label', fallbackLabel, locale) || fallbackLabel;
      const displayDesc = translateFeaturedCategoryField(category.link, 'description', category.description, locale);
      const indexLabel = String(idx + 1).padStart(2, '0');
      return (
        <FlippedCard className="motion-reveal h-52">
          <div slot="front" class="category-front-frame editorial-crop-frame border-border/80 group relative flex h-full flex-col justify-end overflow-hidden rounded-[0.875rem] border p-5 text-left shadow-[var(--ed-surface-shadow)]">
            <img
              style={getLqipStyle(category.image)}
              src={category.image}
              alt=""
              loading="lazy"
              decoding="async"
              class="absolute inset-0 -z-10 h-full w-full rounded-[0.875rem] object-cover"
            />
            <div class="absolute inset-0 -z-10 rounded-[0.875rem] bg-linear-to-t from-black/84 via-black/42 to-black/14" />
            <span class="absolute top-3.5 left-4 z-10 inline-flex items-center gap-1.5 font-mono text-[11px] font-semibold tracking-[0.14em] text-white/85 tabular-nums" aria-hidden="true">
              <span>{indexLabel}</span>
              <span class="h-px w-4 bg-white/40" />
            </span>
            {parentCategory?.name ? (
              <span class="absolute top-3 right-3 z-10 rounded border border-white/22 bg-black/48 px-2 py-0.5 text-[11px] font-medium text-white/92 backdrop-blur-xs">
                {translateCategoryName(parentCategory.name, locale)}
              </span>
            ) : null}
            <div class="relative z-10 flex flex-col gap-1">
              <h3 class="text-xl font-bold tracking-wide text-white">{displayName}</h3>
              {displayDesc && <p class="line-clamp-1 text-xs text-white/82">{displayDesc}</p>}
              <p class="mt-1 flex items-center gap-1.5 font-mono text-[11px] font-medium text-white/88 tabular-nums">
                <Icon name="ri:article-line" class="size-3.5" aria-hidden="true" />
                <span>{t(locale, 'category.postCount', { count: category.posts.length })}</span>
              </p>
            </div>
          </div>
          <div slot="back" class="bg-card border-border relative flex h-full flex-col justify-between rounded-[0.875rem] border px-5 pt-12 pb-3.5 text-left shadow-[var(--ed-surface-shadow)]">
            <span class="category-index-tag" aria-hidden="true">
              {indexLabel}
            </span>
            <div class="border-border/80 absolute top-0 right-0 left-0 flex h-10 items-center border-b px-5 pr-12">
              <a class="text-foreground hover:text-primary truncate text-sm font-semibold transition-colors" href={categoryLink}>
                {displayName}
              </a>
            </div>
            <div class="grid max-h-24 grid-cols-2 gap-x-4 gap-y-2 overflow-auto text-sm">
              {categoryInfo?.children?.length
                ? categoryInfo.children.map((child) => (
                    <a
                      href={`${categoryLink}/${categoryMap[child?.name]}`}
                      class="text-primary hover:text-blue truncate text-left font-medium transition-colors duration-300"
                    >
                      {translateCategoryName(child.name, locale)}
                    </a>
                  ))
                : null}
              {posts.map((post) => (
                <a
                  href={localizedPath(routeBuilder(Routes.Post, post), locale)}
                  class="text-foreground/85 hover:text-primary truncate text-left text-xs transition-colors duration-200"
                >
                  {post.title}
                </a>
              ))}
            </div>
            <div class="border-border/65 flex items-center justify-between gap-2 border-t pt-2.5 text-xs">
              <p class="text-muted-foreground flex min-w-0 items-center truncate tabular-nums">
                {parentCategory?.name ? (
                  <a
                    href={parentCategoryLink}
                    class="group hover:text-blue mr-1.5 inline-flex shrink-0 cursor-pointer items-center transition duration-300"
                  >
                    <Icon name="ri:flag-fill" class="mr-0.5 text-xs" />
                    <span>{translateCategoryName(parentCategory.name, locale)}</span>
                  </a>
                ) : null}
                <span class="inline-flex items-center truncate">
                  <Icon name="gg:loadbar-doc" class="mr-1 shrink-0 text-sm" />
                  {categoryInfo?.children?.length
                    ? `${t(locale, 'category.subCategoryCount', { count: categoryInfo.children.length })}, `
                    : ''}
                  {t(locale, 'category.postCount', { count: category.posts?.length ?? 0 })}
                </span>
              </p>
              <a
                href={categoryLink}
                aria-label={displayName}
                class="text-primary hover:text-blue inline-flex shrink-0 items-center gap-0.5 font-semibold whitespace-nowrap transition-colors"
              >
                <span>{t(locale, 'series.viewAll')}</span>
                <Icon name="ri:arrow-right-s-line" class="size-3.5" aria-hidden="true" />
              </a>
            </div>
          </div>
        </FlippedCard>
      );
    })
  }
</div>
