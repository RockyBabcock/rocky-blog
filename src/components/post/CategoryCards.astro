---
import Divider from '@components/ui/Divider.astro';
import { getCategorySlug } from '@lib/content';
import { translateCategoryName } from '@lib/content/categories';
import { Icon } from 'astro-icon/components';
import { featuredCategories } from '@/constants/site-config';
import { localizedPath, t } from '@/i18n';

interface Props {
  categoryCounts?: Record<string, number>;
  locale?: string;
}

const { categoryCounts = {}, locale } = Astro.props;
---

{featuredCategories.length > 0 && (
  <section class="flex flex-col gap-4">
    <Divider>{t(locale, 'home.featuredCategories')}</Divider>
    <div class="grid grid-cols-2 gap-4 md:grid-cols-1">
      {featuredCategories.map((cat) => {
        const slug = cat.link.includes('/') ? cat.link : getCategorySlug(cat.link);
        const count = categoryCounts[cat.label] ?? categoryCounts[cat.link] ?? 0;
        const label = cat.label || translateCategoryName(cat.link, locale);
        return (
          <a
            href={localizedPath(`/categories/${slug}`, locale)}
            class="group relative flex flex-col justify-between overflow-hidden rounded-xl border border-border/70 bg-card p-5 shadow-card transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-card-hover"
          >
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="font-bold text-base text-foreground transition-colors group-hover:text-primary">
                  {label}
                </h3>
                {cat.description && (
                  <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
                    {cat.description}
                  </p>
                )}
              </div>
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary transition-transform group-hover:scale-105">
                <Icon name="ri:folder-open-line" class="h-4.5 w-4.5" />
              </span>
            </div>
            <div class="mt-4 flex items-center justify-between text-xs text-muted-foreground">
              <span>{t(locale, 'stats.articles', { count })}</span>
              <span class="inline-flex items-center gap-1 text-primary opacity-80 transition-transform group-hover:translate-x-0.5 group-hover:opacity-100">
                <Icon name="ri:arrow-right-line" class="h-3.5 w-3.5" />
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}
