---
import type { PostRef } from 'types/blog';
import { localizedPath, t } from '@/i18n';

interface Props {
  posts: PostRef[];
  currentSlug: string;
  seriesName: string;
  locale?: string;
}

const { posts, currentSlug, seriesName, locale } = Astro.props;
const currentIndex = posts.findIndex((p) => p.slug === currentSlug);
const prevPost = currentIndex > 0 ? posts[currentIndex - 1] : null;
const nextPost = currentIndex >= 0 && currentIndex < posts.length - 1 ? posts[currentIndex + 1] : null;
---

{posts.length > 1 && currentIndex >= 0 && (
  <div class="mt-3 shrink-0 border-t border-border/60 pt-3 text-xs">
    <div class="mb-2 flex items-center justify-between text-muted-foreground">
      <span class="truncate font-medium text-foreground/80">{seriesName}</span>
      <span class="shrink-0 tabular-nums">{currentIndex + 1} / {posts.length}</span>
    </div>
    <div class="flex items-center justify-between gap-2">
      {prevPost ? (
        <a
          href={localizedPath(`/post/${prevPost.slug}`, locale)}
          class="truncate rounded-md bg-muted/60 px-2 py-1 text-muted-foreground transition-colors hover:bg-primary/10 hover:text-primary"
          title={prevPost.title}
        >
          ← {t(locale, 'post.prev')}
        </a>
      ) : (
        <span />
      )}
      {nextPost ? (
        <a
          href={localizedPath(`/post/${nextPost.slug}`, locale)}
          class="truncate rounded-md bg-muted/60 px-2 py-1 text-muted-foreground transition-colors hover:bg-primary/10 hover:text-primary"
          title={nextPost.title}
        >
          {t(locale, 'post.next')} →
        </a>
      ) : (
        <span />
      )}
    </div>
  </div>
)}
