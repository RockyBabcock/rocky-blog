---
import ResponsiveImage from '@components/common/ResponsiveImage.astro';
import { getPostLastCategory, getPostSlug } from '@lib/content';
import { translateCategoryName } from '@lib/content/categories';
import { getPostDescriptionWithSummary, getPostWordStats, getRandomCover } from '@lib/content/posts';
import { displayDate } from '@lib/date';
import { getLqipStyle } from '@lib/lqip';
import { Icon } from 'astro-icon/components';
import type { BlogPost } from 'types/blog';
import { localizedPath, t } from '@/i18n';

interface Props {
  post: BlogPost;
  index?: number;
  locale?: string;
}

const { post, index = 0, locale } = Astro.props;
const slug = getPostSlug(post);
const href = localizedPath(`/post/${slug}`, locale);
const cover = post.data.cover || getRandomCover(slug);
const lqipStyle = getLqipStyle(cover);
const isReversed = index % 2 === 1;
const category = getPostLastCategory(post);
const categoryLabel = category.name ? translateCategoryName(category.name, locale) : '';
const description = getPostDescriptionWithSummary(post);
const { words, minutes } = getPostWordStats(post.body ?? '');
---

<article
  class:list={[
    'post-card group relative flex overflow-hidden rounded-xl border border-border/70 bg-card shadow-card transition-all duration-300 hover:shadow-card-hover md:flex-col',
    isReversed ? 'flex-row-reverse' : 'flex-row',
  ]}
>
  <a
    href={href}
    class:list={[
      'post-card-cover relative block w-[44%] shrink-0 overflow-hidden bg-muted md:h-48 md:w-full',
      isReversed ? 'post-card-cover-right' : 'post-card-cover-left',
    ]}
    style={lqipStyle}
    aria-label={post.data.title}
  >
    <ResponsiveImage
      src={cover}
      alt={post.data.title}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading={index < 2 ? 'eager' : 'lazy'}
    />
    {post.data.sticky && (
      <span class="absolute top-3 left-3 inline-flex items-center gap-1 rounded-full bg-primary/90 px-2.5 py-0.5 text-[11px] font-semibold text-white shadow-sm backdrop-blur-xs">
        <Icon name="ri:pushpin-fill" class="h-3 w-3" />
        {t(locale, 'home.pinned')}
      </span>
    )}
  </a>

  <div class="flex min-w-0 flex-1 flex-col justify-between p-5 md:p-4">
    <div>
      <div class="mb-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
        <time datetime={post.data.date.toISOString()} class="inline-flex items-center gap-1">
          <Icon name="ri:calendar-line" class="h-3.5 w-3.5 text-primary/75" />
          {displayDate(post.data.date)}
        </time>
        <span class="inline-flex items-center gap-1">
          <Icon name="ri:quill-pen-line" class="h-3.5 w-3.5 text-primary/75" />
          {t(locale, 'post.wordCount', { count: words.toLocaleString() })}
        </span>
        <span class="inline-flex items-center gap-1">
          <Icon name="ri:time-line" class="h-3.5 w-3.5 text-primary/75" />
          {t(locale, 'post.readingTime', { minutes })}
        </span>
      </div>

      <h3 class="mb-2.5 line-clamp-2 font-bold text-lg text-foreground transition-colors group-hover:text-primary md:text-base">
        <a href={href} class="hover:underline decoration-primary/40 underline-offset-4">
          {post.data.title}
        </a>
      </h3>

      {description && (
        <p class="line-clamp-3 text-sm leading-relaxed text-muted-foreground">
          {description}
        </p>
      )}
    </div>

    <div class="mt-4 flex items-center justify-between gap-2 pt-2 text-xs">
      <div class="flex flex-wrap items-center gap-2 min-w-0">
        {categoryLabel && (
          <a
            href={localizedPath(category.link, locale)}
            class="inline-flex items-center gap-1 text-muted-foreground transition-colors hover:text-primary"
          >
            <Icon name="ri:folder-2-line" class="h-3.5 w-3.5 text-primary/75" />
            <span>{categoryLabel}</span>
          </a>
        )}
        {post.data.tags?.slice(0, 2).map((tag) => (
          <a
            href={localizedPath(`/tags/${encodeURIComponent(tag)}`, locale)}
            class="inline-flex items-center gap-0.5 text-muted-foreground/85 transition-colors hover:text-primary"
          >
            <span class="text-primary/60">#</span>
            {tag}
          </a>
        ))}
      </div>

      <a
        href={href}
        class="inline-flex shrink-0 items-center gap-1 rounded-full bg-primary/10 px-3 py-1 font-medium text-primary transition-colors hover:bg-primary hover:text-white"
      >
        <span>{t(locale, 'post.readMore')}</span>
        <Icon name="ri:arrow-right-line" class="h-3.5 w-3.5" />
      </a>
    </div>
  </div>
</article>
