---
/**
 * FeaturedShowcase — Asymmetric Editorial Bento Showcase for sticky & highlighted posts.
 *
 * Uses 100% real posts (highlighted series posts + sticky posts). Renders a tall visual
 * lead feature card paired with distinct horizontal secondary cards so the top of the
 * homepage reads like a curated editorial magazine rather than a flat list.
 */

import ResponsiveImage from '@components/common/ResponsiveImage.astro';
import { Routes } from '@constants/router';
import { defaultCoverList } from '@constants/site-config';
import { buildCategoryPath, getCategoryArr, translateCategoryName } from '@lib/content';
import { formatLocalizedDate } from '@lib/date';
import { getLqipProps } from '@lib/lqip';
import { postTitleMorphName } from '@lib/morph-transitions';
import { routeBuilder } from '@lib/route';
import { Icon } from 'astro-icon/components';
import { defaultLocale, getLocaleLabel, localizedPath, t } from '@/i18n';
import type { PostCardData } from '@/types/blog';

interface Props {
  posts: PostCardData[];
  locale: string;
}

const { posts, locale } = Astro.props;
const leadPost = posts[0];
const secondaryPosts = posts.slice(1, 4);

function resolvePostMeta(post: PostCardData, fallbackIndex: number) {
  const cover = post.cover ?? defaultCoverList[fallbackIndex % defaultCoverList.length];
  const href = localizedPath(routeBuilder(Routes.Post, { slug: post.slug, link: post.link, title: post.title }), locale);
  const categoryArr = getCategoryArr(post.categories?.[0]);
  const categoryLink = localizedPath(buildCategoryPath(categoryArr), locale);
  const categoryLabel = categoryArr.length ? translateCategoryName(categoryArr[categoryArr.length - 1], locale) : '';
  const isFallback = post.postLocale != null && locale !== defaultLocale && post.postLocale !== locale;
  return {
    cover,
    href,
    categoryLink,
    categoryLabel,
    isFallback,
    lqip: getLqipProps(cover),
    titleMorph: postTitleMorphName(post.slug),
  };
}

const leadMeta = leadPost ? resolvePostMeta(leadPost, 0) : null;
const layoutMode = secondaryPosts.length === 0 ? 'single' : secondaryPosts.length === 1 ? '2' : 'many';
---

{
  leadPost && leadMeta && (
    <section aria-labelledby="home-featured-heading" class="flex flex-col gap-4" data-home-featured>
      <div class="editorial-section-head">
        <div class="editorial-section-title-group">
          <h2 id="home-featured-heading" class="editorial-section-title">
            <Icon name="ri:sparkling-2-line" class="text-primary size-5 shrink-0" aria-hidden="true" />
            <span>{t(locale, 'home.featuredSection')}</span>
          </h2>
          <p class="editorial-section-subtitle">{t(locale, 'home.featuredSubtitle')}</p>
        </div>
        <a href={localizedPath('/archives', locale)} class="editorial-section-link">
          <span>{t(locale, 'home.viewAllPosts')}</span>
          <Icon name="ri:arrow-right-s-line" class="size-4" aria-hidden="true" />
        </a>
      </div>

      <div class="featured-bento" data-count={layoutMode}>
        {/* Primary Editorial Feature Card */}
        <article class="featured-lead-card motion-reveal group">
          <a href={leadMeta.href} tabindex="-1" aria-hidden="true" style={leadMeta.lqip.style} class={`absolute inset-0 ${leadMeta.lqip.class}`}>
            <ResponsiveImage
              src={leadMeta.cover}
              maxWidth={1000}
              sizes="(max-width: 768px) calc(100vw - 32px), (max-width: 1280px) 60vw, 560px"
              loading="eager"
              decoding="async"
              alt=""
              class="h-full w-full object-cover"
            />
          </a>
          <div class="featured-lead-scrim" />

          <div class="relative z-10 flex flex-col gap-2.5 p-6 text-white md:p-4">
            <div class="flex flex-wrap items-center gap-2 text-xs text-white/85">
              <span class="bg-primary/85 inline-flex items-center gap-1 rounded-md px-2 py-0.5 font-medium text-white">
                <Icon name="ri:pushpin-2-fill" class="size-3" aria-hidden="true" />
                {t(locale, 'post.pinned')}
              </span>
              {leadMeta.categoryLabel && (
                <a
                  href={leadMeta.categoryLink}
                  class="hover:text-primary-foreground inline-flex items-center gap-1 rounded-md bg-white/15 px-2 py-0.5 backdrop-blur-xs transition-colors hover:bg-white/25"
                >
                  {leadMeta.categoryLabel}
                </a>
              )}
              {leadMeta.isFallback && (
                <span class="inline-flex items-center gap-1 rounded-md bg-amber-500/25 px-2 py-0.5 text-amber-100">
                  <Icon name="ri:translate-2" class="size-3" aria-hidden="true" />
                  {getLocaleLabel(leadPost.postLocale ?? defaultLocale)}
                </span>
              )}
            </div>

            <a href={leadMeta.href} class="outline-none">
              <h3
                class="line-clamp-2 text-2xl leading-snug font-bold tracking-tight text-white transition-colors group-hover:text-pink-100 md:text-xl"
                transition:name={leadMeta.titleMorph}
                transition:animate="initial"
                data-morph={leadMeta.titleMorph}
              >
                {leadPost.title}
              </h3>
            </a>

            {leadPost.description && (
              <p class="line-clamp-2 text-sm leading-relaxed text-white/80 md:text-xs">{leadPost.description}</p>
            )}

            <div class="mt-1 flex flex-wrap items-center justify-between gap-3 pt-1 text-xs text-white/80">
              <div class="flex flex-wrap items-center gap-3 tabular-nums">
                <span class="inline-flex items-center gap-1">
                  <Icon name="fa6-solid:calendar-days" class="size-3" aria-hidden="true" />
                  {formatLocalizedDate(leadPost.date, locale)}
                </span>
                <span class="inline-flex items-center gap-1">
                  <Icon name="fa6-solid:clock" class="size-3" aria-hidden="true" />
                  {leadPost.readingTime}
                </span>
              </div>
              <a
                href={leadMeta.href}
                class="inline-flex items-center gap-1 font-medium text-white transition-transform group-hover:translate-x-0.5"
              >
                <span>{t(locale, 'post.readMore')}</span>
                <Icon name="ri:arrow-right-line" class="size-3.5" aria-hidden="true" />
              </a>
            </div>
          </div>
        </article>

        {/* Secondary Featured Stack */}
        {secondaryPosts.length > 0 && (
          <div class="featured-sub-stack">
            {secondaryPosts.map((post, idx) => {
              const meta = resolvePostMeta(post, idx + 2);
              const isSingleSecondary = secondaryPosts.length === 1;
              return (
                <article
                  class="featured-sub-card motion-reveal group"
                  data-layout={isSingleSecondary ? 'vertical' : 'horizontal'}
                >
                  <a
                    href={meta.href}
                    tabindex="-1"
                    aria-hidden="true"
                    style={meta.lqip.style}
                    class={
                      isSingleSecondary
                        ? `relative h-44 w-full shrink-0 overflow-hidden md:h-40 ${meta.lqip.class}`
                        : `relative w-28 shrink-0 overflow-hidden rounded-lg md:w-24 ${meta.lqip.class}`
                    }
                  >
                    <ResponsiveImage
                      src={meta.cover}
                      maxWidth={isSingleSecondary ? 640 : 400}
                      sizes={isSingleSecondary ? '(max-width: 768px) calc(100vw - 32px), 340px' : '140px'}
                      loading="eager"
                      decoding="async"
                      alt=""
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  </a>
                  <div
                    class={
                      isSingleSecondary
                        ? 'flex min-w-0 flex-1 flex-col justify-between gap-2 p-4'
                        : 'flex min-w-0 flex-1 flex-col justify-between gap-1.5 py-0.5'
                    }
                  >
                    <div class="flex flex-col gap-1.5">
                      <div class="text-muted-foreground flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs">
                        {meta.categoryLabel && (
                          <a href={meta.categoryLink} class="text-primary hover:text-blue font-medium transition-colors">
                            {meta.categoryLabel}
                          </a>
                        )}
                        <span class="tabular-nums">{formatLocalizedDate(post.date, locale)}</span>
                      </div>
                      <a href={meta.href} class="outline-none">
                        <h3
                          class={
                            isSingleSecondary
                              ? 'text-foreground group-hover:text-primary line-clamp-2 text-lg leading-snug font-bold transition-colors md:text-base'
                              : 'text-foreground group-hover:text-primary line-clamp-2 text-base leading-snug font-semibold transition-colors md:text-sm'
                          }
                          transition:name={meta.titleMorph}
                          transition:animate="initial"
                          data-morph={meta.titleMorph}
                        >
                          {post.title}
                        </h3>
                      </a>
                      {post.description && (
                        <p class={isSingleSecondary ? 'text-muted-foreground line-clamp-3 text-xs leading-relaxed' : 'text-muted-foreground line-clamp-2 text-xs leading-relaxed'}>
                          {post.description}
                        </p>
                      )}
                    </div>
                    <div class="text-muted-foreground mt-1 flex items-center justify-between gap-2 text-xs tabular-nums">
                      <span class="inline-flex items-center gap-1">
                        <Icon name="fa6-solid:clock" class="size-3" aria-hidden="true" />
                        {post.readingTime}
                      </span>
                      <a href={meta.href} class="text-primary inline-flex items-center gap-0.5 font-medium hover:underline">
                        {t(locale, 'post.readMore')}
                        <Icon name="ri:arrow-right-s-line" class="size-3.5" aria-hidden="true" />
                      </a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        )}
      </div>
    </section>
  )
}
