---
import AnnouncementProvider from '@components/announcement/AnnouncementProvider.astro';
import GlobalBGMPlayer from '@components/bgm/GlobalBGMPlayer';
import RoundedFonts from '@components/common/RoundedFonts.astro';
import FloatingGroup from '@components/layout/FloatingGroup';
import Footer from '@components/layout/Footer.astro';
import Header from '@components/layout/Header.astro';
import MobileDrawer from '@components/layout/MobileDrawer.astro';
import { SearchDialog } from '@components/layout/SearchDialog';
import SettingsPanel from '@components/settings/SettingsPanel';
import { HomeSiderType } from '@constants/enum';
import { bgmConfig, siteConfig } from '@constants/site-config';
import { getPostSlug, getSortedPosts } from '@lib/content';
import { translateCategoryName } from '@lib/content/categories';
import { getPostDescriptionWithSummary, getPostLastCategory } from '@lib/content/posts';
import type { BlogPost } from 'types/blog';
import { defaultLocale, getLocaleFromUrl } from '@/i18n';
import '@/styles/index.css';

interface Props {
  title?: string;
  description?: string;
  cover?: string;
  coverTitle?: string;
  coverSubtitle?: string;
  isPostPage?: boolean;
  tocNumbering?: boolean;
  siderType?: HomeSiderType;
  post?: BlogPost;
  locale?: string;
  compactHero?: boolean;
}

const {
  title,
  description = siteConfig.description,
  cover = siteConfig.defaultCover,
  coverTitle = siteConfig.title,
  coverSubtitle = siteConfig.subtitle,
  isPostPage = false,
  tocNumbering = true,
  siderType = HomeSiderType.HOME,
  post,
  locale: passedLocale,
  compactHero = false,
} = Astro.props;

const locale = passedLocale ?? getLocaleFromUrl(Astro.url.pathname) ?? defaultLocale;
const pageTitle = title ? `${title} | ${siteConfig.title}` : siteConfig.title;

const allLocalePosts = await getSortedPosts(locale);
const searchItems = allLocalePosts.map((p) => {
  const cat = getPostLastCategory(p);
  return {
    title: p.data.title,
    slug: getPostSlug(p),
    description: getPostDescriptionWithSummary(p),
    tags: p.data.tags ?? [],
    category: cat.name ? translateCategoryName(cat.name, locale) : undefined,
    date: p.data.date.toISOString().slice(0, 10),
  };
});

const heroCover = cover || '/img/site_header_1600.webp';
---

<!doctype html>
<html lang={locale} data-locale={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={isPostPage ? 'article' : 'website'} />
    <link rel="stylesheet" href="/katex/katex.min.css" />
    <RoundedFonts />

    <!-- Inline FOUC-free theme & motion preference boot -->
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem('theme');
          const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          const isDark = saved === 'dark' || (!saved && prefersDark);
          document.documentElement.classList.toggle('dark', isDark);

          const motion = localStorage.getItem('koharu-motion-level');
          if (motion === 'reduced') {
            document.documentElement.classList.add('motion-off');
          }
        } catch (e) {}
      })();
    </script>
  </head>

  <body class="flex min-h-screen flex-col bg-background text-foreground antialiased">
    <Header isPostPage={isPostPage} tocNumbering={tocNumbering} />

    <!-- Hero Banner with Shoka wave transition -->
    <section
      class:list={[
        'hero-banner relative flex w-full flex-col items-center justify-center text-center text-white',
        compactHero ? 'h-[42vh] min-h-[260px] max-h-[380px]' : 'h-[56vh] min-h-[340px] max-h-[520px]',
      ]}
    >
      <img
        src={heroCover}
        alt={coverTitle}
        class="absolute inset-0 h-full w-full object-cover object-center"
        loading="eager"
        decoding="async"
      />
      <div
        class="absolute inset-0 bg-gradient-to-b from-black/45 via-black/30 to-black/55"
        aria-hidden="true"
      />

      <div class="relative z-10 mx-auto flex max-w-4xl flex-col items-center gap-3 px-6 pt-12 pb-10">
        <slot name="hero">
          <h1 class="shadow-text font-extrabold text-4xl tracking-tight text-white md:text-2xl">
            {coverTitle}
          </h1>
          {coverSubtitle && (
            <p class="shadow-text max-w-2xl text-base text-white/90 md:text-sm">
              {coverSubtitle}
            </p>
          )}
        </slot>
      </div>

      <svg
        class="hero-waves"
        xmlns="http://www.w3.org/2000/svg"
        xmlns:xlink="http://www.w3.org/1999/xlink"
        viewBox="0 24 150 28"
        preserveAspectRatio="none"
        shape-rendering="auto"
        aria-hidden="true"
      >
        <defs>
          <path
            id="koharu-gentle-wave"
            d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z"
          />
        </defs>
        <g class="hero-parallax">
          <use xlink:href="#koharu-gentle-wave" x="48" y="0" fill="var(--background)" opacity="0.4" />
          <use xlink:href="#koharu-gentle-wave" x="48" y="3" fill="var(--background)" opacity="0.6" />
          <use xlink:href="#koharu-gentle-wave" x="48" y="5" fill="var(--background)" opacity="0.8" />
          <use xlink:href="#koharu-gentle-wave" x="48" y="7" fill="var(--background)" />
        </g>
      </svg>
    </section>

    <main class="relative z-10 flex-1 pb-12">
      <slot />
    </main>

    <Footer />

    <MobileDrawer type={siderType} post={post} />
    <FloatingGroup client:only="react" />
    <SettingsPanel client:only="react" />
    <SearchDialog client:idle items={searchItems} />
    <AnnouncementProvider />
    {bgmConfig.enabled && bgmConfig.audio.length > 0 && (
      <GlobalBGMPlayer client:idle audioGroups={bgmConfig.audio} metingApi={bgmConfig.metingApi} />
    )}

    <script>
      import { setLocale } from '@store/locale';

      function syncLocale() {
        const lang = document.documentElement.getAttribute('data-locale') || 'zh';
        setLocale(lang);
      }

      if (document.readyState !== 'loading') syncLocale();
      document.addEventListener('astro:page-load', syncLocale);
    </script>
  </body>
</html>
