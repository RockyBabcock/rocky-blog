---
import HomeSider from '@components/layout/HomeSider.astro';
import { HomeSiderType } from '@constants/enum';
import { MAX_WIDTH } from '@constants/layout';
import type { BlogPost } from 'types/blog';
import Layout from './Layout.astro';

interface Props {
  title?: string;
  description?: string;
  cover?: string;
  coverTitle?: string;
  coverSubtitle?: string;
  isPostPage?: boolean;
  tocNumbering?: boolean;
  siderType?: HomeSiderType;
  post?: BlogPost;
  locale?: string;
  compactHero?: boolean;
}

const {
  title,
  description,
  cover,
  coverTitle,
  coverSubtitle,
  isPostPage = false,
  tocNumbering = true,
  siderType = HomeSiderType.HOME,
  post,
  locale,
  compactHero = false,
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  cover={cover}
  coverTitle={coverTitle}
  coverSubtitle={coverSubtitle}
  isPostPage={isPostPage}
  tocNumbering={tocNumbering}
  siderType={siderType}
  post={post}
  locale={locale}
  compactHero={compactHero}
>
  <slot name="hero" slot="hero">
    {coverTitle && (
      <h1 class="shadow-text font-extrabold text-4xl tracking-tight text-white md:text-2xl">
        {coverTitle}
      </h1>
    )}
    {coverSubtitle && (
      <p class="shadow-text max-w-2xl text-base text-white/90 md:text-sm">
        {coverSubtitle}
      </p>
    )}
  </slot>

  <div class:list={['mx-auto mt-6 flex w-full items-start gap-6 px-4 md:mt-4 md:px-3', MAX_WIDTH.content]}>
    <HomeSider type={siderType} post={post} />

    <div class="min-w-0 flex-1">
      <slot />
    </div>
  </div>
</Layout>
