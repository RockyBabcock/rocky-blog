---
import { MAX_WIDTH } from '@constants/layout';
import { cn } from '@lib/utils';
import type { BlogPost } from 'types/blog';
import Footer from '@/components/layout/Footer.astro';
import PostFooter from '@/components/post/PostFooter.astro';

interface Props {
  className?: string;
  post?: BlogPost;
  /** Utility pages can omit article-only related/random footer content. */
  showPostFooter?: boolean;
}

const { className, post, showPostFooter = true } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<div class="flex flex-col">
  <slot name="cover" />
  <div
    class={cn(
      'two-column-content mx-auto md:mx-0 flex w-full items-start justify-center md:w-full',
      hasAside ? MAX_WIDTH.editorial : MAX_WIDTH.content,
      hasAside && 'has-editorial-aside',
      className,
    )}
  >
    <slot name="sider" />
    <div class="two-column-main flex min-w-0 grow flex-col gap-8 md:w-full">
      <slot />
      {showPostFooter && <div data-focus-hide><PostFooter post={post} /></div>}
      <Footer />
    </div>
    {hasAside && (
      <aside class="page-home-aside" data-focus-hide>
        <slot name="aside" />
      </aside>
    )}
  </div>
</div>

<style>
  @media (width > 992px) {
    /* Reserve the sidebar's full height so its header-following motion cannot shrink a short page. */
    .two-column-content:global(:has(> .page-home-sider)) {
      min-height: 100vh;
    }
  }
</style>
