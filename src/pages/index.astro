---
import BotanicalMarks from '@components/common/BotanicalMarks.astro';
import EditorialKicker from '@components/common/EditorialKicker.astro';
import EditorialTimeline from '@components/home/EditorialTimeline.astro';
import ExploreTopics from '@components/home/ExploreTopics.astro';
import FeaturedShowcase from '@components/home/FeaturedShowcase.astro';
import HomeCompactUtility from '@components/home/HomeCompactUtility';
import HomeRightRail from '@components/home/HomeRightRail.astro';
import RecentReadingStrip from '@components/home/RecentReadingStrip';
import SeriesShowcase from '@components/home/SeriesShowcase.astro';
import HomeSider from '@components/layout/HomeSider.astro';
import PostList from '@components/post/PostList.astro';
import Cover from '@components/ui/cover/Cover.astro';
import { CONTENT_PADDING, PAGINATION } from '@constants/layout';
import { seoConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { getEnabledSeries, getHomePagePosts, getPostsBySeriesSlug, getSortedPosts } from '@lib/content';
import { toPostCardDataList } from '@lib/content/transforms';
import type { Page } from 'astro';
import { Icon } from 'astro-icon/components';
import type { BlogPost } from 'types/blog';
import { defaultLocale, localizedPath, t } from '@/i18n';

interface Props {
  locale?: string;
}

// Root pages render the default locale; `[lang]/` mirrors pass their locale in explicitly.
const { locale = defaultLocale } = Astro.props;

// Fetch real homepage data & sorted posts (memoized per locale)
const [{ highlightedPosts, stickyPosts: normalStickyPosts, regularPosts }, allPosts] = await Promise.all([
  getHomePagePosts(locale),
  getSortedPosts(locale),
]);

// Combine highlighted series posts + sticky posts for the Featured Bento Showcase
const stickyPosts = toPostCardDataList([...highlightedPosts, ...normalStickyPosts], locale);

// Paginated Latest Writing stream (non-series posts)
const { pageSize } = PAGINATION;
const regularPostsSlice = regularPosts.slice(0, pageSize);
const posts = toPostCardDataList(regularPostsSlice, locale);
const totalRegularPosts = regularPosts.length;

const homeUrl = localizedPath('/', locale);
const postsBaseUrl = localizedPath('/posts', locale);

const page: Page<BlogPost> = {
  data: regularPostsSlice,
  start: 0,
  end: Math.min(pageSize - 1, regularPostsSlice.length - 1),
  size: pageSize,
  total: totalRegularPosts,
  currentPage: 1,
  lastPage: Math.ceil(totalRegularPosts / pageSize),
  url: {
    current: homeUrl,
    prev: undefined,
    next: totalRegularPosts > pageSize ? `${postsBaseUrl}/2` : undefined,
    first: homeUrl,
    last: `${postsBaseUrl}/${Math.ceil(totalRegularPosts / pageSize)}`,
  },
};

// Compute accurate sequential editorial numbering based on actually rendered homepage sections
const enabledSeries = getEnabledSeries();
const hasSeriesSection = (await Promise.all(enabledSeries.map((s) => getPostsBySeriesSlug(s.slug, locale)))).some(
  (list) => list.length > 0,
);
const hasFeaturedSection = stickyPosts.length > 0;

let sectionCounter = 0;
const nextSectionNum = () => String(++sectionCounter).padStart(2, '0');
const featuredSectionNum = hasFeaturedSection ? nextSectionNum() : undefined;
const latestSectionNum = nextSectionNum();
const seriesSectionNum = hasSeriesSection ? nextSectionNum() : undefined;
const topicsSectionNum = nextSectionNum();
const timelineSectionNum = nextSectionNum();
---

<Layout locale={locale} title={seoConfig.title}>
  <TwoColumnLayout showPostFooter={false}>
    <Cover slot="cover" />
    <HomeSider slot="sider" />
    <HomeRightRail slot="aside" posts={allPosts} locale={locale} />

    <div
      id="home-content"
      class={`editorial-paper-surface bg-gradient-start shadow-box tablet:shadow-none flex flex-col gap-9 overflow-clip scroll-mt-18 ${CONTENT_PADDING.editorial}`}
    >
      {/* Compact Search & Continue Reading bar for < 1280px viewports */}
      <div class="home-compact-utility">
        <HomeCompactUtility client:idle locale={locale} />
        <RecentReadingStrip client:idle locale={locale} />
      </div>

      {/* 1. Featured Editorial Showcase */}
      {hasFeaturedSection && <FeaturedShowcase posts={stickyPosts} locale={locale} sectionNumber={featuredSectionNum} />}

      {hasFeaturedSection && (
        <div class="editorial-rule" aria-hidden="true">
          <span class="editorial-rule-line" />
          <BotanicalMarks variant="divider-sakura" />
          <span class="editorial-rule-line" />
        </div>
      )}

      {/* 2. Latest Writing (Mixed Visual Cards + Compact Editorial Index) */}
      <section aria-labelledby="home-latest-heading" class="flex flex-col gap-4" data-home-latest>
        <div class="editorial-section-head">
          <div class="editorial-section-title-group">
            <EditorialKicker label="WRITING" number={latestSectionNum} variant="numbered" />
            <h2 id="home-latest-heading" class="editorial-section-title">
              <Icon name="ri:quill-pen-line" class="text-primary size-5 shrink-0" aria-hidden="true" />
              <span>{t(locale, 'post.latestPosts')}</span>
            </h2>
            <p class="editorial-section-subtitle">{t(locale, 'home.latestSubtitle')}</p>
          </div>
          {totalRegularPosts > pageSize && (
            <a href={`${postsBaseUrl}/2`} class="editorial-section-link">
              <span>{t(locale, 'series.viewAll')}</span>
              <Icon name="ri:arrow-right-s-line" class="size-4" aria-hidden="true" />
            </a>
          )}
        </div>
        <PostList
          posts={posts}
          page={page}
          showPaginator={true}
          baseUrl={postsBaseUrl}
          isHomePage={true}
          mixedRhythm={true}
        />
      </section>

      {/* 3. Series & Weekly Showcase (clean whitespace transition from Latest Writing) */}
      {hasSeriesSection && <SeriesShowcase locale={locale} sectionNumber={seriesSectionNum} />}

      <div class="editorial-rule" aria-hidden="true">
        <span class="editorial-rule-line" />
        <BotanicalMarks variant="divider-celestial" />
        <span class="editorial-rule-line" />
      </div>

      {/* 4. Explore Topics (Categories & Weighted Popular Tags) */}
      <ExploreTopics posts={allPosts} locale={locale} sectionNumber={topicsSectionNum} />

      <div class="editorial-rule" aria-hidden="true">
        <span class="editorial-rule-line" />
      </div>

      {/* 5. Editorial Timeline */}
      <EditorialTimeline posts={allPosts} locale={locale} sectionNumber={timelineSectionNum} />
    </div>
  </TwoColumnLayout>
</Layout>
