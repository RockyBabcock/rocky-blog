---
import PageIntro from '@components/common/PageIntro.astro';
import PostYears from '@components/common/PostYears.astro';
import { HomeSiderType } from '@constants/enum';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { getSortedPosts } from '@lib/content';
import { defaultLocale, t } from '@/i18n';

interface Props {
  locale?: string;
}

const locale = Astro.props.locale ?? defaultLocale;
const posts = await getSortedPosts(locale);
---

<TwoColumnLayout
  title={t(locale, 'nav.archives')}
  coverTitle={t(locale, 'nav.archives')}
  siderType={HomeSiderType.HOME}
  locale={locale}
  compactHero={true}
>
  <div class="rounded-2xl border border-border/70 bg-card p-7 shadow-card md:p-5">
    <PageIntro stats={[{ value: posts.length, label: t(locale, 'stats.postsLabel') }]} />
    <div class="mt-4">
      <PostYears posts={posts} locale={locale} anchors={true} />
    </div>
  </div>
</TwoColumnLayout>
