---
import FriendsContent from '@components/friends/FriendsContent.astro';
import { HomeSiderType } from '@constants/enum';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { defaultLocale, t } from '@/i18n';

interface Props {
  locale?: string;
}

const locale = Astro.props.locale ?? defaultLocale;
---

<TwoColumnLayout
  title={t(locale, 'nav.friends')}
  coverTitle={t(locale, 'friends.title')}
  coverSubtitle={t(locale, 'friends.subtitle')}
  siderType={HomeSiderType.HOME}
  locale={locale}
  compactHero={true}
>
  <div class="rounded-2xl border border-border/70 bg-card p-7 shadow-card md:p-5">
    <FriendsContent locale={locale} />
  </div>
</TwoColumnLayout>
