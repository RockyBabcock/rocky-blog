---
import PostList from '@components/post/PostList.astro';
import { HomeSiderType } from '@constants/enum';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { getSortedPosts } from '@lib/content';
import type { GetStaticPathsOptions } from 'astro';
import type { BlogPost } from 'types/blog';
import { defaultLocale, localizedPath, t } from '@/i18n';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getSortedPosts(defaultLocale);
  return paginate(posts, { pageSize: 10 });
}

interface Props {
  page: {
    data: BlogPost[];
    currentPage: number;
    lastPage: number;
    url: { prev?: string; next?: string };
  };
}

const { page } = Astro.props;
const locale = defaultLocale;
---

<TwoColumnLayout
  title={t(locale, 'nav.posts')}
  coverTitle={t(locale, 'nav.posts')}
  siderType={HomeSiderType.HOME}
  locale={locale}
  compactHero={true}
>
  <PostList posts={page.data} locale={locale} />

  {page.lastPage > 1 && (
    <nav class="mt-8 flex items-center justify-center gap-3 text-sm" aria-label="Pagination">
      {page.url.prev && (
        <a
          href={localizedPath(page.url.prev, locale)}
          class="rounded-full border border-border bg-card px-4 py-1.5 text-foreground transition-colors hover:border-primary hover:text-primary"
        >
          ← {t(locale, 'pagination.prev')}
        </a>
      )}
      <span class="text-xs text-muted-foreground tabular-nums">
        {page.currentPage} / {page.lastPage}
      </span>
      {page.url.next && (
        <a
          href={localizedPath(page.url.next, locale)}
          class="rounded-full border border-border bg-card px-4 py-1.5 text-foreground transition-colors hover:border-primary hover:text-primary"
        >
          {t(locale, 'pagination.next')} →
        </a>
      )}
    </nav>
  )}
</TwoColumnLayout>
