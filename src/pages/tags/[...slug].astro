---
import PostList from '@components/post/PostList.astro';
import { HomeSiderType } from '@constants/enum';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { getAllTags, getSortedPosts } from '@lib/content';
import { defaultLocale, localizedPath, t } from '@/i18n';

export async function getStaticPaths() {
  const posts = await getSortedPosts(defaultLocale);
  const tags = Object.keys(getAllTags(posts));
  return tags.map((tag) => ({
    params: { slug: tag },
    props: { tag, locale: defaultLocale },
  }));
}

interface Props {
  tag: string;
  locale?: string;
}

const { tag, locale = defaultLocale } = Astro.props;
const allPosts = await getSortedPosts(locale);
const posts = allPosts.filter((p) => p.data.tags?.includes(tag));
---

<TwoColumnLayout
  title={`#${tag} - ${t(locale, 'nav.tags')}`}
  coverTitle={`# ${tag}`}
  coverSubtitle={t(locale, 'stats.articles', { count: posts.length })}
  siderType={HomeSiderType.HOME}
  locale={locale}
  compactHero={true}
>
  <div class="mb-4 flex items-center justify-between text-xs text-muted-foreground">
    <a href={localizedPath('/tags', locale)} class="hover:text-primary">
      ← {t(locale, 'nav.tags')}
    </a>
    <span>{t(locale, 'stats.articles', { count: posts.length })}</span>
  </div>
  <PostList posts={posts} locale={locale} />
</TwoColumnLayout>
