---
import PageIntro from '@components/common/PageIntro.astro';
import { HomeSiderType } from '@constants/enum';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { getAllTags, getSortedPosts } from '@lib/content';
import { defaultLocale, localizedPath, t } from '@/i18n';

interface Props {
  locale?: string;
}

const locale = Astro.props.locale ?? defaultLocale;
const posts = await getSortedPosts(locale);
const tags = Object.entries(getAllTags(posts)).sort((a, b) => b[1] - a[1]);
---

<TwoColumnLayout
  title={t(locale, 'nav.tags')}
  coverTitle={t(locale, 'nav.tags')}
  siderType={HomeSiderType.HOME}
  locale={locale}
  compactHero={true}
>
  <div class="rounded-2xl border border-border/70 bg-card p-7 shadow-card md:p-5">
    <PageIntro stats={[{ value: tags.length, label: t(locale, 'stats.tagsLabel') }]} />

    <div class="mt-6 flex flex-wrap gap-3">
      {tags.map(([tag, count]) => (
        <a
          href={localizedPath(`/tags/${encodeURIComponent(tag)}`, locale)}
          class="inline-flex items-center gap-1.5 rounded-full border border-border/70 bg-background/70 px-4 py-2 text-sm font-medium text-foreground transition-all hover:-translate-y-0.5 hover:border-primary hover:bg-primary/10 hover:text-primary"
        >
          <span class="text-primary">#</span>
          <span>{tag}</span>
          <span class="rounded-full bg-muted px-2 py-0.5 text-xs text-muted-foreground tabular-nums">
            {count}
          </span>
        </a>
      ))}
    </div>
  </div>
</TwoColumnLayout>
