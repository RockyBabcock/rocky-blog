---
import { render } from 'astro:content';
import BotanicalMarks from '@components/common/BotanicalMarks.astro';
import CustomContent from '@components/common/CustomContent.astro';
import HomeSider from '@components/layout/HomeSider.astro';
import FocusModeToggle from '@components/post/FocusModeToggle';
import PostPagination from '@components/post/PostPagination.astro';
import PostShareActions from '@components/post/PostShareActions';
import SaveArticleButton from '@components/post/SaveArticleButton';
import SeriesContextBanner from '@components/post/SeriesContextBanner.astro';
import SummaryPanel from '@components/post/SummaryPanel';
import Cover from '@components/ui/cover/Cover.astro';
import { defaultContentConfig } from '@constants/content-config';
import { HomeSiderType } from '@constants/enum';
import { CONTENT_PADDING } from '@constants/layout';
import { siteConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import {
  buildCategoryPath,
  getCategoryArr,
  getPostAvailableLocales,
  getPostById,
  getPostDescription,
  getPostLastCategory,
  getPostLocale,
  getPostSlug,
  translateCategoryName,
  translateSeriesField,
} from '@lib/content';
import {
  buildBreadcrumbJsonLd,
  buildPostBreadcrumbs,
  buildPostJsonLd,
  buildPostKeywords,
  hasMathSyntax,
} from '@lib/content/post-page';
import { getAdjacentSeriesPosts, getEnabledSeries, getSeriesPosts } from '@lib/content/series';
import { toPostRef } from '@lib/content/transforms';
import { formatForSeo, formatLocalizedDate } from '@lib/date';
import { encodeSlug } from '@lib/route';
import { getOgImageUrl } from '@lib/seo/og-image';
import { Icon } from 'astro-icon/components';
import readingTime from 'reading-time';
import { defaultLocale, getLocaleLabel, localizedPath, t } from '@/i18n';
import { postRoute } from '../_shared/routes';

export const getStaticPaths = postRoute.root;

interface Props {
  postId: string;
  locale: string;
}

const { postId, locale } = Astro.props;
// Look up by locale first (may find a translated version); fall back to defaultLocale
// which is guaranteed to exist since getStaticPaths enumerates from defaultLocale posts.
const post =
  (await getPostById(postId, locale)) ?? (locale !== defaultLocale ? await getPostById(postId, defaultLocale) : undefined);
if (!post) throw new Error(`Post not found: ${postId}`);

const originalLocale = getPostLocale(post);
const isFallback = originalLocale !== locale;
const availableLocales = await getPostAvailableLocales(post);
// For fallback pages (showing default-locale content under /en/), canonical should point to the original
const postSlug = getPostSlug(post);
const originalPostUrl = localizedPath(`/post/${encodeSlug(postSlug)}`, originalLocale);
const canonicalUrl = isFallback
  ? new URL(localizedPath(`/post/${encodeSlug(postSlug)}`, defaultLocale), Astro.site).href
  : undefined;
const { Content } = await render(post);
const adjacent = await getAdjacentSeriesPosts(post, locale);
const prevPost = adjacent.prevPost ? toPostRef(adjacent.prevPost) : null;
const nextPost = adjacent.nextPost ? toPostRef(adjacent.nextPost) : null;
const { title, categories = [], tags = [], date, math: postMath, keywords: postKeywords = [] } = post?.data ?? {};

const seriesPosts = await getSeriesPosts(post, locale);
const lastCategory = getPostLastCategory(post);
const matchedFeaturedSeries = getEnabledSeries().find((series) => series.categoryName === lastCategory.name);
const seriesIndex = seriesPosts.findIndex((item) => getPostSlug(item) === postSlug);
const showSeriesBanner = Boolean(seriesPosts.length >= 2 && seriesIndex >= 0 && lastCategory.name);
const seriesBannerName = matchedFeaturedSeries
  ? translateSeriesField(matchedFeaturedSeries.slug, 'fullName', matchedFeaturedSeries.fullName, locale) ||
    translateSeriesField(matchedFeaturedSeries.slug, 'label', matchedFeaturedSeries.label, locale) ||
    translateCategoryName(lastCategory.name, locale)
  : translateCategoryName(lastCategory.name, locale);
const seriesBannerHref = matchedFeaturedSeries
  ? localizedPath(`/${matchedFeaturedSeries.slug}`, locale)
  : localizedPath(lastCategory.link, locale);

const hasMath = hasMathSyntax(defaultContentConfig.enableMath, postMath, post.body);
const finalDescription = getPostDescription(post, locale);
const ogImage = getOgImageUrl(post?.data.cover, Astro.site);

const keywords = buildPostKeywords({
  postKeywords,
  tags,
  categories,
  siteKeywords: siteConfig.keywords,
});

const jsonLd = buildPostJsonLd({
  title,
  description: finalDescription,
  keywords,
  authorName: siteConfig.author ?? siteConfig.name,
  siteUrl: Astro.site,
  datePublished: formatForSeo(date),
  dateModified: post.data.updated ? formatForSeo(post.data.updated) : undefined,
  ogImage,
  pageUrl: Astro.url.href,
});

const categoryArr = getCategoryArr(categories?.[0]);
const translatedCategories = categoryArr.map((c) => translateCategoryName(c, locale));
const categoryStr = translatedCategories.length ? ` | ${translatedCategories.join(' / ')}` : '';
const primaryCategoryLabel = translatedCategories[translatedCategories.length - 1] ?? '';
const breadcrumbCategories = buildPostBreadcrumbs(
  categoryArr,
  (partial) => localizedPath(buildCategoryPath(partial), locale),
  (name) => translateCategoryName(name, locale),
);

const homeName = t(locale, 'breadcrumb.home');
const breadcrumbJsonLd = buildBreadcrumbJsonLd({
  homeName,
  homeHref: localizedPath('/', locale),
  breadcrumbs: breadcrumbCategories,
  title,
  siteUrl: Astro.site,
});

const currentPostUrl = localizedPath(`/post/${encodeSlug(postSlug)}`, locale);
const summaryText = post.data.description?.trim() || null;
const isEncryptedPost = Boolean(post.data.password);
const seoDate = formatForSeo(date);
const publishedDateLabel = formatLocalizedDate(date, locale);
const readStats = readingTime(post.body ?? '');
---

<Layout
  locale={locale}
  title={`${post.data.title}${categoryStr} | ${siteConfig.title}`}
  description={finalDescription}
  siderType={HomeSiderType.POST}
  post={post}
  canonical={canonicalUrl}
  keywords={keywords}
  availableLocales={availableLocales}
  openGraph={{ type: 'article' }}
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  {hasMath && <link slot="head" rel="stylesheet" href="/katex/katex.min.css" />}
  <TwoColumnLayout post={post}>
    <Cover slot="cover" data={post} />
    <HomeSider slot="sider" type={HomeSiderType.POST} post={post} />
    <div
      data-reading-surface
      data-reading-post
      data-post-slug={postSlug}
      data-post-title={title}
      data-post-url={currentPostUrl}
      data-post-locale={locale}
      data-post-category={primaryCategoryLabel}
      data-post-description={finalDescription}
      data-post-cover={post.data.cover}
      data-post-date={publishedDateLabel}
      data-post-reading-time={readStats.text}
      data-post-encrypted={isEncryptedPost ? 'true' : 'false'}
      data-available-locales={availableLocales.join(',')}
      class={`editorial-paper-surface shadow-box bg-gradient-start flex min-w-0 w-full max-w-full flex-col gap-2 overflow-x-clip ${CONTENT_PADDING.standard}`}
    >
      <!-- Breadcrumb Navigation & Reading Toolbar -->
      <nav
        aria-label={t(locale, 'breadcrumb.home')}
        class="article-reading-toolbar border-border/65 text-muted-foreground mb-1 flex flex-wrap items-center justify-between gap-x-3 gap-y-2 border-b pb-3 text-sm"
      >
        <div class="flex min-w-0 flex-wrap items-center gap-1.5">
          <div class="flex items-center gap-1">
            <!-- Home Icon and Link -->
            <Icon name="fa6-solid:house-chimney" class="h-4 w-4 shrink-0" />
            <a href={localizedPath('/', locale)} aria-label={homeName}>
              <span class="hover:text-blue transition-colors duration-300">{homeName}</span>
            </a>
          </div>
          <!-- Category Breadcrumbs -->
          {
            breadcrumbCategories.map((category, index) => (
              <>
                <Icon name="ri:arrow-right-s-line" class="text-muted-foreground/60 h-4 w-4 shrink-0" />
                <a
                  href={category.link}
                  class={`hover:text-blue transition-colors duration-300 ${index === breadcrumbCategories.length - 1 ? 'text-primary bg-primary/10 hover:text-primary hover:bg-primary/20 rounded-full px-2.5 py-0.5 font-medium' : ''}`}
                  aria-label={t(locale, 'breadcrumb.goToCategory', { name: category.name })}
                >
                  {category.name}
                </a>
              </>
            ))
          }
        </div>
        <div class="flex flex-wrap items-center gap-1.5">
          <SaveArticleButton
            client:idle
            slug={postSlug}
            title={title}
            url={currentPostUrl}
            locale={locale}
            category={primaryCategoryLabel || undefined}
            description={finalDescription}
            cover={post.data.cover}
            publishedAt={publishedDateLabel}
            readingTime={readStats.text}
          />
          <FocusModeToggle client:idle locale={locale} />
          <PostShareActions client:idle locale={locale} title={title} description={finalDescription} />
        </div>
      </nav>
      <div class="mx-auto flex w-full max-w-[min(100%,var(--reader-measure,78ch))] flex-col gap-3">
        {isFallback && (
          <div class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-amber-500/20 bg-amber-500/10 px-4 py-3 text-sm text-amber-700 dark:text-amber-400">
            <div class="flex items-center gap-2">
              <Icon name="ri:translate-2" class="h-4 w-4 shrink-0" />
              <span>{t(locale, 'post.fallbackNotice', { lang: getLocaleLabel(locale) })}</span>
            </div>
            <a
              href={originalPostUrl}
              class="inline-flex items-center gap-1 rounded-full border border-amber-500/30 bg-amber-500/10 px-3 py-1 text-xs font-medium transition-colors hover:bg-amber-500/20"
            >
              <span>{t(locale, 'post.viewOriginal', { lang: getLocaleLabel(originalLocale) })}</span>
              <Icon name="ri:arrow-right-up-line" class="size-3.5" aria-hidden="true" />
            </a>
          </div>
        )}
        {
          showSeriesBanner && (
            <SeriesContextBanner
              locale={locale}
              seriesName={seriesBannerName}
              seriesHref={seriesBannerHref}
              currentPosition={seriesIndex + 1}
              totalCount={seriesPosts.length}
              prevPost={prevPost}
              nextPost={nextPost}
            />
          )
        }
        {
          !isEncryptedPost && summaryText && (
            <SummaryPanel client:visible summary={summaryText} locale={locale} />
          )
        }
        <article
          class="prose dark:prose-invert"
          data-pagefind-body={isEncryptedPost ? undefined : ''}
          data-pagefind-ignore={isEncryptedPost ? 'all' : undefined}
        >
          {!isEncryptedPost && (
            <div class="hidden" aria-hidden="true">
              <span data-pagefind-meta={`title:${title}`} />
              <span data-pagefind-meta={`date:${seoDate}`} />
              <span data-pagefind-meta={`locale:${locale}`} data-pagefind-filter={`language:${locale}`} />
              {primaryCategoryLabel && <span data-pagefind-meta={`category:${primaryCategoryLabel}`} />}
              {translatedCategories.map((cat) => (
                <span data-pagefind-filter={`category:${cat}`} />
              ))}
              {tags.length > 0 && <span data-pagefind-meta={`tags:${tags.join(',')}`} />}
              {tags.map((tag) => (
                <span data-pagefind-filter={`tag:${tag}`} />
              ))}
            </div>
          )}
          <CustomContent Content={Content} />
        </article>
        <div class="article-end-colophon" aria-hidden="true">
          <span class="article-end-colophon-mark">
            <BotanicalMarks variant="divider-sakura" />
            <span>END</span>
          </span>
        </div>
        <PostPagination prevPost={prevPost} nextPost={nextPost} locale={locale} />
      </div>
    </div>
  </TwoColumnLayout>
</Layout>
