---
import { render } from 'astro:content';
import CustomContent from '@components/common/CustomContent.astro';
import HomeSider from '@components/layout/HomeSider.astro';
import PostPagination from '@components/post/PostPagination.astro';
import SummaryPanel from '@components/post/SummaryPanel';
import Cover from '@components/ui/cover/Cover.astro';
import { defaultContentConfig } from '@constants/content-config';
import { HomeSiderType } from '@constants/enum';
import { CONTENT_PADDING } from '@constants/layout';
import { devConfig, siteConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { postActionsConfig } from '@lib/config/site';
import {
  buildCategoryPath,
  getCategoryArr,
  getPostById,
  getPostDescription,
  getPostLocale,
  getPostSlug,
  translateCategoryName,
} from '@lib/content';
import {
  buildBreadcrumbJsonLd,
  buildLocalEditorLinks,
  buildPostBreadcrumbs,
  buildPostJsonLd,
  buildPostKeywords,
  getPostRelativePath,
  hasMathSyntax,
} from '@lib/content/post-page';
import { getPostSourceFilename, getPostSourcePath, isPostSourcePublic } from '@lib/content/post-source';
import { getAdjacentSeriesPosts } from '@lib/content/series';
import { toPostRef } from '@lib/content/transforms';
import { formatForSeo } from '@lib/date';
import { encodeSlug } from '@lib/route';
import { getOgImageUrl } from '@lib/seo/og-image';
import { Icon } from 'astro-icon/components';
import PostMarkdownActions from '@/components/post/PostMarkdownActions';
import { defaultLocale, getLocaleLabel, localizedPath, t } from '@/i18n';
import { postRoute } from '../_shared/routes';

export const getStaticPaths = postRoute.root;

interface Props {
  postId: string;
  locale: string;
}

const { postId, locale } = Astro.props;
// Look up by locale first (may find a translated version); fall back to defaultLocale
// which is guaranteed to exist since getStaticPaths enumerates from defaultLocale posts.
const post =
  (await getPostById(postId, locale)) ?? (locale !== defaultLocale ? await getPostById(postId, defaultLocale) : undefined);
if (!post) throw new Error(`Post not found: ${postId}`);

const postRelativePath = getPostRelativePath(post.filePath);
const isFallback = getPostLocale(post) !== locale;
// For fallback pages (showing default-locale content under /en/), canonical should point to the original
const postSlug = getPostSlug(post);
const canonicalUrl = isFallback
  ? new URL(localizedPath(`/post/${encodeSlug(postSlug)}`, defaultLocale), Astro.site).href
  : undefined;
const { Content } = await render(post);
const adjacent = await getAdjacentSeriesPosts(post, locale);
const prevPost = adjacent.prevPost ? toPostRef(adjacent.prevPost) : null;
const nextPost = adjacent.nextPost ? toPostRef(adjacent.nextPost) : null;
const { title, categories = [], tags = [], date, math: postMath, keywords: postKeywords = [] } = post?.data ?? {};

const hasMath = hasMathSyntax(defaultContentConfig.enableMath, postMath, post.body);
const finalDescription = getPostDescription(post, locale);
const ogImage = getOgImageUrl(post?.data.cover, Astro.site);

const keywords = buildPostKeywords({
  postKeywords,
  tags,
  categories,
  siteKeywords: siteConfig.keywords,
});

const jsonLd = buildPostJsonLd({
  title,
  description: finalDescription,
  keywords,
  authorName: siteConfig.author ?? siteConfig.name,
  siteUrl: Astro.site,
  datePublished: formatForSeo(date),
  dateModified: post.data.updated ? formatForSeo(post.data.updated) : undefined,
  ogImage,
  pageUrl: Astro.url.href,
});

const categoryArr = getCategoryArr(categories?.[0]);
const categoryStr = categoryArr?.length ? ` | ${categoryArr.map((c) => translateCategoryName(c, locale)).join(' / ')}` : '';
const breadcrumbCategories = buildPostBreadcrumbs(
  categoryArr,
  (partial) => localizedPath(buildCategoryPath(partial), locale),
  (name) => translateCategoryName(name, locale),
);

const homeName = t(locale, 'breadcrumb.home');
const breadcrumbJsonLd = buildBreadcrumbJsonLd({
  homeName,
  homeHref: localizedPath('/', locale),
  breadcrumbs: breadcrumbCategories,
  title,
  siteUrl: Astro.site,
});

const postSourcePath = getPostSourcePath(localizedPath(`/post/${encodeSlug(postSlug)}`, locale));
const localEditors = buildLocalEditorLinks(import.meta.env.DEV, devConfig, postRelativePath);
const summaryText = post.data.description?.trim() || null;
---

<Layout
  locale={locale}
  title={`${post.data.title}${categoryStr} | ${siteConfig.title}`}
  description={finalDescription}
  siderType={HomeSiderType.POST}
  post={post}
  canonical={canonicalUrl}
  keywords={keywords}
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  {hasMath && <link slot="head" rel="stylesheet" href="/katex/katex.min.css" />}
  <TwoColumnLayout post={post}>
    <Cover slot="cover" data={post} />
    <HomeSider slot="sider" type={HomeSiderType.POST} post={post} />
    <div
      class={`shadow-box bg-gradient-start flex min-w-0 w-full max-w-full flex-col gap-2 overflow-x-clip ${CONTENT_PADDING.standard}`}
    >
      <!-- Breadcrumb Navigation -->
      <nav class="text-muted-foreground flex items-center justify-between gap-2 text-sm">
        <div class="flex items-center gap-2">
          <div class="flex items-center gap-1">
            <!-- Home Icon and Link -->
            <Icon name="fa6-solid:house-chimney" class="h-4 w-4" />
            <a href={localizedPath('/', locale)} aria-label={homeName}>
              <span class="hover:text-blue transition-colors duration-300">{homeName}</span>
            </a>
          </div>
          <!-- Category Breadcrumbs -->
          {
            breadcrumbCategories.map((category, index) => (
              <>
                <Icon name="ri:arrow-right-s-line" class="text-muted-foreground/60 h-4 w-4" />
                <a
                  href={category.link}
                  class={`hover:text-blue transition-colors duration-300 ${index === breadcrumbCategories.length - 1 ? 'text-primary bg-primary/10 hover:text-primary hover:bg-primary/20 rounded-full px-2.5 py-1' : ''}`}
                  aria-label={t(locale, 'breadcrumb.goToCategory', { name: category.name })}
                >
                  {category.name}
                </a>
              </>
            ))
          }
        </div>
        {
          isPostSourcePublic(post.data, post.body, import.meta.env.PROD) && (
            <PostMarkdownActions
              client:idle
              locale={locale}
              sourcePath={postSourcePath}
              filename={getPostSourceFilename(postSlug)}
              copy={postActionsConfig.copyMarkdown}
              download={postActionsConfig.downloadMarkdown}
              localEditors={localEditors}
            />
          )
        }
      </nav>
      {isFallback && (
        <div class="flex items-center gap-2 rounded-lg border border-amber-500/20 bg-amber-500/10 px-4 py-3 text-sm text-amber-700 dark:text-amber-400">
          <Icon name="ri:translate-2" class="h-4 w-4 shrink-0" />
          <span>{t(locale, 'post.fallbackNotice', { lang: getLocaleLabel(locale) })}</span>
        </div>
      )}
      {
        !post.data.password && summaryText && (
          <SummaryPanel client:visible summary={summaryText} className="mt-2" locale={locale} />
        )
      }
      <article class="prose dark:prose-invert" data-pagefind-body>
        <CustomContent Content={Content} />
      </article>
      <PostPagination prevPost={prevPost} nextPost={nextPost} locale={locale} />
    </div>
  </TwoColumnLayout>
</Layout>
