---
import { render } from 'astro:content';
import CustomContent from '@components/common/CustomContent.astro';
import PostNavigation from '@components/post/PostNavigation.astro';
import { HomeSiderType } from '@constants/enum';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { getPostSlug, getSortedPosts } from '@lib/content';
import { translateCategoryName } from '@lib/content/categories';
import { getPostDescriptionWithSummary, getPostLastCategory, getPostWordStats, getRandomCover } from '@lib/content/posts';
import { displayDate } from '@lib/date';
import { Icon } from 'astro-icon/components';
import type { BlogPost } from 'types/blog';
import { defaultLocale, localizedPath, t } from '@/i18n';

export async function getStaticPaths() {
  const posts = await getSortedPosts(defaultLocale);
  return posts.map((post, index) => ({
    params: { slug: getPostSlug(post) },
    props: {
      post,
      prevPost: index > 0 ? posts[index - 1] : null,
      nextPost: index < posts.length - 1 ? posts[index + 1] : null,
      locale: defaultLocale,
    },
  }));
}

interface Props {
  post: BlogPost;
  prevPost: BlogPost | null;
  nextPost: BlogPost | null;
  locale?: string;
}

const { post, prevPost, nextPost, locale = defaultLocale } = Astro.props;
const { Content } = await render(post);
const slug = getPostSlug(post);
const cover = post.data.cover || getRandomCover(slug);
const description = getPostDescriptionWithSummary(post);
const category = getPostLastCategory(post);
const categoryLabel = category.name ? translateCategoryName(category.name, locale) : '';
const { words, minutes } = getPostWordStats(post.body ?? '');
---

<TwoColumnLayout
  title={post.data.title}
  description={description}
  cover={cover}
  coverTitle={post.data.title}
  isPostPage={true}
  tocNumbering={post.data.tocNumbering ?? true}
  siderType={HomeSiderType.POST}
  post={post}
  locale={locale}
  compactHero={true}
>
  <div slot="hero" class="flex flex-col items-center gap-3">
    <h1 class="shadow-text max-w-3xl font-extrabold text-3xl leading-snug text-white md:text-2xl">
      {post.data.title}
    </h1>
    <div class="shadow-text flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-xs text-white/90">
      <time datetime={post.data.date.toISOString()} class="inline-flex items-center gap-1">
        <Icon name="ri:calendar-line" class="h-3.5 w-3.5" />
        {displayDate(post.data.date)}
      </time>
      <span class="inline-flex items-center gap-1">
        <Icon name="ri:quill-pen-line" class="h-3.5 w-3.5" />
        {t(locale, 'post.wordCount', { count: words.toLocaleString() })}
      </span>
      <span class="inline-flex items-center gap-1">
        <Icon name="ri:time-line" class="h-3.5 w-3.5" />
        {t(locale, 'post.readingTime', { minutes })}
      </span>
      {categoryLabel && (
        <a
          href={localizedPath(category.link, locale)}
          class="inline-flex items-center gap-1 underline-offset-4 hover:underline"
        >
          <Icon name="ri:folder-2-line" class="h-3.5 w-3.5" />
          {categoryLabel}
        </a>
      )}
    </div>
  </div>

  <article class="rounded-2xl border border-border/70 bg-card p-8 shadow-card md:p-5">
    <!-- Breadcrumbs -->
    <nav class="mb-6 flex flex-wrap items-center gap-1.5 text-xs text-muted-foreground" aria-label="Breadcrumb">
      <a href={localizedPath('/', locale)} class="inline-flex items-center gap-1 hover:text-primary">
        <Icon name="ri:home-4-line" class="h-3.5 w-3.5" />
        <span>{t(locale, 'nav.home')}</span>
      </a>
      {categoryLabel && (
        <>
          <span>/</span>
          <a href={localizedPath(category.link, locale)} class="hover:text-primary">
            {categoryLabel}
          </a>
        </>
      )}
      <span>/</span>
      <span class="truncate text-foreground/80">{post.data.title}</span>
    </nav>

    <div class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-bold prose-a:text-primary prose-a:no-underline hover:prose-a:underline">
      <CustomContent Content={Content} />
    </div>

    {post.data.tags && post.data.tags.length > 0 && (
      <div class="mt-8 flex flex-wrap items-center gap-2 border-t border-border/60 pt-5">
        {post.data.tags.map((tag) => (
          <a
            href={localizedPath(`/tags/${encodeURIComponent(tag)}`, locale)}
            class="inline-flex items-center gap-1 rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary transition-colors hover:bg-primary hover:text-white"
          >
            <Icon name="ri:hashtag" class="h-3 w-3" />
            <span>{tag}</span>
          </a>
        ))}
      </div>
    )}

    <PostNavigation prevPost={prevPost} nextPost={nextPost} locale={locale} />
  </article>
</TwoColumnLayout>
