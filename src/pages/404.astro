---
import { MAX_WIDTH } from '@constants/layout';
import Layout from '@layouts/Layout.astro';
import { defaultLocale, localizedPath, t } from '@/i18n';

const locale = defaultLocale;
---

<Layout
  title="404"
  coverTitle="404"
  coverSubtitle={t(locale, 'notFound.description')}
  locale={locale}
  compactHero={true}
>
  <div class:list={['mx-auto mt-10 flex w-full flex-col items-center justify-center px-4 text-center', MAX_WIDTH.content]}>
    <div class="rounded-2xl border border-border/70 bg-card px-10 py-12 shadow-card">
      <div class="font-extrabold text-6xl text-primary">404</div>
      <h2 class="mt-3 font-bold text-xl text-foreground">{t(locale, 'notFound.title')}</h2>
      <p class="mt-2 text-sm text-muted-foreground">{t(locale, 'notFound.description')}</p>
      <a
        href={localizedPath('/', locale)}
        class="mt-6 inline-flex items-center rounded-full bg-primary px-6 py-2.5 text-sm font-semibold text-white shadow-sakura-sm transition-transform hover:scale-105"
      >
        {t(locale, 'notFound.backHome')}
      </a>
    </div>
  </div>
</Layout>
