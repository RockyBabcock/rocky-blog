---
import { HomeSiderType } from '@constants/enum';
import { bgmConfig } from '@constants/site-config';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { Icon } from 'astro-icon/components';
import { defaultLocale, t } from '@/i18n';

interface Props {
  locale?: string;
}

const locale = Astro.props.locale ?? defaultLocale;
---

<TwoColumnLayout
  title={t(locale, 'nav.music')}
  coverTitle={t(locale, 'nav.music')}
  siderType={HomeSiderType.HOME}
  locale={locale}
  compactHero={true}
>
  <div class="rounded-2xl border border-border/70 bg-card p-8 shadow-card md:p-5">
    <div class="flex items-center gap-3 border-b border-border/60 pb-5">
      <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/12 text-primary">
        <Icon name="ri:music-2-line" class="h-6 w-6" />
      </div>
      <div>
        <h2 class="font-bold text-xl text-foreground">{t(locale, 'nav.music')}</h2>
        <p class="text-xs text-muted-foreground">
          {bgmConfig.audio.length > 0 ? `${bgmConfig.audio.length} Playlists configured` : 'BGM Player'}
        </p>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-1">
      {bgmConfig.audio.map((group) => (
        <div class="rounded-xl border border-border/70 bg-background/60 p-5">
          <div class="flex items-center justify-between">
            <h3 class="font-semibold text-base text-foreground">{group.title}</h3>
            <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-xs text-primary">
              {group.list.length} items
            </span>
          </div>
          <ul class="mt-3 flex flex-col gap-1.5 text-xs text-muted-foreground">
            {group.list.map((item) => (
              <li class="truncate font-mono opacity-80">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</TwoColumnLayout>
