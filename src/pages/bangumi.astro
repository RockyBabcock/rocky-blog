---
import { BangumiCollection } from '@components/bangumi/BangumiCollection';
import { HomeSiderType } from '@constants/enum';
import { bangumiConfig } from '@constants/site-config';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { defaultLocale, t } from '@/i18n';

interface Props {
  locale?: string;
}

const locale = Astro.props.locale ?? defaultLocale;
const userId = bangumiConfig?.username ?? '';
---

<TwoColumnLayout
  title={t(locale, 'nav.bangumi')}
  coverTitle={t(locale, 'nav.bangumi')}
  siderType={HomeSiderType.HOME}
  locale={locale}
  compactHero={true}
>
  <div class="rounded-2xl border border-border/70 bg-card p-7 shadow-card md:p-5">
    {userId ? (
      <BangumiCollection client:load userId={userId} />
    ) : (
      <p class="py-10 text-center text-sm text-muted-foreground">
        Bangumi username is not configured in config/site.yaml.
      </p>
    )}
  </div>
</TwoColumnLayout>
