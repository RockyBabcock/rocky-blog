---
import { featuredSeriesList } from '@constants/site-config';
import type { FeaturedSeriesItem } from '@lib/config/types';
import { getLocaleStaticPaths } from '@/i18n';
import SeriesPage from '../[seriesSlug].astro';

export function getStaticPaths() {
  const locales = getLocaleStaticPaths();
  const enabledSeries = featuredSeriesList.filter((s) => s.enabled);
  const paths: Array<{
    params: { lang: string; seriesSlug: string };
    props: { series: FeaturedSeriesItem; locale: string };
  }> = [];

  for (const { params: { lang } } of locales) {
    for (const series of enabledSeries) {
      paths.push({
        params: { lang, seriesSlug: series.slug },
        props: { series, locale: lang },
      });
    }
  }

  return paths;
}

const props = Astro.props;
---

<SeriesPage {...props} />
