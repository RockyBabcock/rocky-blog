---
import { getAllTags, getSortedPosts } from '@lib/content';
import { getLocaleStaticPaths } from '@/i18n';
import TagPage from '../../tags/[...slug].astro';

export async function getStaticPaths() {
  const locales = getLocaleStaticPaths();
  const paths: Array<{ params: { lang: string; slug: string }; props: { tag: string; locale: string } }> = [];

  for (const { params: { lang } } of locales) {
    const posts = await getSortedPosts(lang);
    const tags = Object.keys(getAllTags(posts));
    for (const tag of tags) {
      paths.push({
        params: { lang, slug: tag },
        props: { tag, locale: lang },
      });
    }
  }

  return paths;
}

const props = Astro.props;
---

<TagPage {...props} />
