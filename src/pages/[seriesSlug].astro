---
import PostList from '@components/post/PostList.astro';
import { HomeSiderType } from '@constants/enum';
import { featuredSeriesList } from '@constants/site-config';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import type { FeaturedSeriesItem } from '@lib/config/types';
import { getSeriesPostsByCategory } from '@lib/content/posts';
import { defaultLocale } from '@/i18n';

export async function getStaticPaths() {
  return featuredSeriesList
    .filter((s) => s.enabled)
    .map((series) => ({
      params: { seriesSlug: series.slug },
      props: { series, locale: defaultLocale },
    }));
}

interface Props {
  series: FeaturedSeriesItem;
  locale?: string;
}

const { series, locale = defaultLocale } = Astro.props;
const posts = await getSeriesPostsByCategory(series.categoryName, locale);
---

<TwoColumnLayout
  title={series.fullName}
  description={series.description}
  cover={series.cover}
  coverTitle={series.fullName}
  coverSubtitle={series.description}
  siderType={HomeSiderType.HOME}
  locale={locale}
  compactHero={true}
>
  <PostList posts={posts} locale={locale} />
</TwoColumnLayout>
