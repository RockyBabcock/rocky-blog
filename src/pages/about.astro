---
import { HomeSiderType } from '@constants/enum';
import { siteConfig } from '@constants/site-config';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { Icon } from 'astro-icon/components';
import { defaultLocale, t } from '@/i18n';

interface Props {
  locale?: string;
}

const locale = Astro.props.locale ?? defaultLocale;
---

<TwoColumnLayout
  title={t(locale, 'nav.about')}
  coverTitle={t(locale, 'about.title')}
  coverSubtitle={siteConfig.subtitle}
  siderType={HomeSiderType.HOME}
  locale={locale}
  compactHero={true}
>
  <article class="rounded-2xl border border-border/70 bg-card p-8 shadow-card md:p-5">
    <div class="flex flex-col items-center gap-4 border-b border-border/60 pb-6 text-center">
      <img
        src={siteConfig.avatar}
        alt={siteConfig.author}
        class="h-24 w-24 rounded-full border-4 border-primary/25 object-cover shadow-sakura-sm"
      />
      <div>
        <h2 class="font-bold text-2xl text-foreground">{siteConfig.author}</h2>
        <p class="mt-1 text-sm text-muted-foreground">{siteConfig.description}</p>
      </div>
    </div>

    <div class="prose prose-slate dark:prose-invert mt-6 max-w-none">
      <p>
        {siteConfig.title} — {siteConfig.subtitle}
      </p>
      <p>
        Built with <strong>Astro 7</strong>, <strong>React 19</strong>, and <strong>Tailwind CSS v4</strong>, inspired by the classic Shoka aesthetic.
      </p>
      <div class="not-prose mt-6 grid grid-cols-3 gap-4 md:grid-cols-1">
        <div class="rounded-xl border border-border/70 bg-background/60 p-4">
          <div class="mb-2 flex items-center gap-2 font-semibold text-sm text-primary">
            <Icon name="ri:flashlight-line" class="h-4 w-4" />
            <span>Static First</span>
          </div>
          <p class="text-xs leading-relaxed text-muted-foreground">
            Zero unnecessary runtime JavaScript with selective React island hydration.
          </p>
        </div>
        <div class="rounded-xl border border-border/70 bg-background/60 p-4">
          <div class="mb-2 flex items-center gap-2 font-semibold text-sm text-primary">
            <Icon name="ri:translate-2" class="h-4 w-4" />
            <span>Multilingual</span>
          </div>
          <p class="text-xs leading-relaxed text-muted-foreground">
            Supports Chinese, English, Japanese, and Korean with seamless route switching.
          </p>
        </div>
        <div class="rounded-xl border border-border/70 bg-background/60 p-4">
          <div class="mb-2 flex items-center gap-2 font-semibold text-sm text-primary">
            <Icon name="ri:palette-line" class="h-4 w-4" />
            <span>Dual Theme</span>
          </div>
          <p class="text-xs leading-relaxed text-muted-foreground">
            Sakura light mode and crisp charcoal dark mode with FOUC-free switching.
          </p>
        </div>
      </div>
    </div>
  </article>
</TwoColumnLayout>
