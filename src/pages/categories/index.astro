---
import PageIntro from '@components/common/PageIntro.astro';
import PostYears from '@components/common/PostYears.astro';
import { HomeSiderType } from '@constants/enum';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { getCategoryList, getSortedPosts } from '@lib/content';
import { getCategorySlug, translateCategoryName } from '@lib/content/categories';
import { Icon } from 'astro-icon/components';
import { defaultLocale, localizedPath, t } from '@/i18n';

interface Props {
  locale?: string;
}

const locale = Astro.props.locale ?? defaultLocale;
const { categories, countMap } = await getCategoryList(locale);
const posts = await getSortedPosts(locale);
---

<TwoColumnLayout
  title={t(locale, 'nav.categories')}
  coverTitle={t(locale, 'nav.categories')}
  siderType={HomeSiderType.HOME}
  locale={locale}
  compactHero={true}
>
  <div class="rounded-2xl border border-border/70 bg-card p-7 shadow-card md:p-5">
    <PageIntro
      stats={[
        { value: Object.keys(countMap).length, label: t(locale, 'stats.categoriesLabel') },
        { value: posts.length, label: t(locale, 'stats.postsLabel') },
      ]}
    />

    <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-1">
      {categories.map((cat) => (
        <div class="rounded-xl border border-border/70 bg-background/50 p-4 transition-colors hover:border-primary/40">
          <a
            href={localizedPath(`/categories/${getCategorySlug(cat.name)}`, locale)}
            class="flex items-center justify-between font-bold text-base text-foreground hover:text-primary"
          >
            <span class="inline-flex items-center gap-2">
              <Icon name="ri:folder-2-line" class="h-4.5 w-4.5 text-primary" />
              {translateCategoryName(cat.name, locale)}
            </span>
            <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-semibold text-primary tabular-nums">
              {countMap[cat.name] ?? 0}
            </span>
          </a>

          {cat.children && cat.children.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-2 border-t border-border/50 pt-3">
              {cat.children.map((child) => (
                <li>
                  <a
                    href={localizedPath(`/categories/${getCategorySlug(cat.name)}/${getCategorySlug(child.name)}`, locale)}
                    class="inline-flex items-center gap-1 rounded-full bg-muted px-2.5 py-1 text-xs text-muted-foreground transition-colors hover:bg-primary/10 hover:text-primary"
                  >
                    <span>{translateCategoryName(child.name, locale)}</span>
                    <span class="opacity-70 tabular-nums">({countMap[child.name] ?? 0})</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>

    <div class="mt-8">
      <PostYears posts={posts} locale={locale} />
    </div>
  </div>
</TwoColumnLayout>
