---
import PostList from '@components/post/PostList.astro';
import { HomeSiderType } from '@constants/enum';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { getCategoryList, getSortedPosts } from '@lib/content';
import { getCategorySlug, translateCategoryName } from '@lib/content/categories';
import { getPostsByCategory } from '@lib/content/posts';
import type { Category } from 'types/blog';
import { defaultLocale, localizedPath, t } from '@/i18n';

export async function getStaticPaths() {
  const { categories } = await getCategoryList(defaultLocale);
  const paths: Array<{ params: { slug: string }; props: { categoryName: string; locale: string } }> = [];

  function walk(nodes: Category[], prefix = '') {
    for (const node of nodes) {
      const segment = getCategorySlug(node.name);
      const fullSlug = prefix ? `${prefix}/${segment}` : segment;
      paths.push({
        params: { slug: fullSlug },
        props: { categoryName: node.name, locale: defaultLocale },
      });
      if (node.children?.length) {
        walk(node.children, fullSlug);
      }
    }
  }

  walk(categories);
  return paths;
}

interface Props {
  categoryName: string;
  locale?: string;
}

const { categoryName, locale = defaultLocale } = Astro.props;
const allPosts = await getSortedPosts(locale);
const posts = getPostsByCategory(allPosts, categoryName);
const displayName = translateCategoryName(categoryName, locale);
---

<TwoColumnLayout
  title={`${displayName} - ${t(locale, 'nav.categories')}`}
  coverTitle={displayName}
  coverSubtitle={t(locale, 'stats.articles', { count: posts.length })}
  siderType={HomeSiderType.HOME}
  locale={locale}
  compactHero={true}
>
  <div class="mb-4 flex items-center justify-between text-xs text-muted-foreground">
    <a href={localizedPath('/categories', locale)} class="hover:text-primary">
      ← {t(locale, 'nav.categories')}
    </a>
    <span>{t(locale, 'stats.articles', { count: posts.length })}</span>
  </div>
  <PostList posts={posts} locale={locale} />
</TwoColumnLayout>
