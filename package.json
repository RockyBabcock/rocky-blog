{
  "name": "rocky-blog",
  "type": "module",
  "version": "7.7.5",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "generate:lqips": "npx tsx src/scripts/generateLqips.ts",
    "generate:all": "npm run generate:lqips",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:fix:unsafe": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "lint-md": "lint-md ./src/content/**/*.{md,mdx}",
    "lint-md:fix": "lint-md ./src/content/**/*.{md,mdx} --fix",
    "lint-staged": "lint-staged",
    "change": "git cliff --bump -o CHANGELOG.md",
    "prepare": "husky",
    "knip": "knip",
    "knip:strict": "knip --include files,dependencies,devDependencies,unlisted,unresolved",
    "test": "npm run test:all",
    "test:all": "npm run test:core",
    "test:core": "npm run test:config && npm run test:i18n && npm run test:features && npm run test:markdown && npm run test:index && npm run test:toc && npm run test:lightbox && npm run test:glide && npm run test:drawer && npm run test:diagram && npm run test:motion && npm run test:settings",
    "test:i18n": "tsx --test src/i18n/translations.test.ts src/lib/date.test.ts src/lib/content/locale.test.ts",
    "test:features": "tsx --test src/lib/reading-history.test.ts src/lib/saved-articles.test.ts src/lib/collection-controls.test.ts src/lib/share.test.ts src/lib/search-helpers.test.ts src/lib/commands.test.ts src/lib/series-progress.test.ts src/lib/editorial.test.ts",
    "test:index": "tsx --test src/lib/content/index-groups.test.ts src/lib/content/index-categories.test.ts src/lib/content/index-tags.test.ts src/lib/content/series-issue.test.ts src/lib/content/post-helpers.test.ts src/lib/content/post-page.test.ts",
    "test:config": "tsx --test src/lib/config/content.test.ts src/lib/config/featured-series.test.ts src/lib/config/motion.test.ts src/lib/config/site-sections.test.ts src/lib/config/site-consistency.test.ts",
    "test:markdown": "tsx --test src/lib/markdown/*.test.ts",
    "test:settings": "tsx --test src/lib/settings-number.test.ts",
    "test:toc": "tsx --test src/lib/toc.test.ts src/lib/toc-ribbon.test.ts",
    "test:lightbox": "tsx --test src/lib/lightbox-flip.test.ts src/lib/lightbox-gestures.test.ts",
    "test:motion": "node --import tsx --test src/lib/motion-level.test.ts src/lib/sakura/petal-physics.test.ts",
    "test:motion:browser": "playwright test -c tests/motion/playwright.config.ts",
    "test:settings-panel": "node tests/settings/panel-animation.mjs",
    "test:glide": "tsx --test src/lib/glide.test.ts",
    "test:drawer": "tsx --test src/lib/drawer-gesture.test.ts src/lib/series-rail.test.ts",
    "test:diagram": "tsx --test src/lib/diagram-sizing.test.ts src/lib/mermaid-source.test.ts src/lib/zoom-pan.test.ts",
    "test:diagram:browser": "node tests/diagram/mermaid.browser.mjs",
    "test:search:browser": "node tests/search/portal.browser.mjs"
  },
  "dependencies": {
    "@antv/infographic": "^0.2.4",
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@floating-ui/react": "^0.27.16",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/gg": "^1.2.2",
    "@iconify-json/ri": "^1.2.6",
    "@iconify/react": "^5.2.1",
    "@nanostores/react": "^0.8.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "astro": "7.1.3",
    "astro-icon": "^1.1.5",
    "astro-loading-indicator": "^0.9.0",
    "astro-mermaid": "^2.1.0",
    "astro-pagefind": "^2.0.1",
    "astro-robots-txt": "^1.0.0",
    "astro-seo": "^1.1.0",
    "astro-tooltips": "^0.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "es-toolkit": "^1.42.0",
    "hast-util-to-html": "^9.0.5",
    "marked": "^17.0.1",
    "mermaid": "^11.12.2",
    "motion": "12.43.0",
    "nanostores": "^0.11.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-error-boundary": "^5.0.0",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sanitize-html": "^2.17.0",
    "sonner": "^2.0.7",
    "spoilerjs": "^0.2.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "transliteration": "^2.6.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^2.6.9",
    "@lint-md/cli": "^2.0.0",
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-yaml": "^5.0.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.1",
    "@types/sanitize-html": "^2.16.0",
    "@types/unist": "^3.0.3",
    "chalk": "^5.6.2",
    "glob": "^13.0.0",
    "husky": "^9.1.7",
    "knip": "^5.71.0",
    "lint-staged": "^15.5.2",
    "sharp": "^0.34.5",
    "shiki": "^4.3.1",
    "sonda": "^0.14.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-svgr": "^5.2.0",
    "yaml": "^2.8.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,astro}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{md,mdx}": [
      "lint-md --fix"
    ]
  }
}
