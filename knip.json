{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/lib/markdown/client-content.ts",
        "src/layouts/PageLayout.astro",
        "docs/design/readme-showcase/record.mjs",
        "tests/**/*.spec.ts",
        "tests/**/playwright.config.ts",
        "tests/**/*.mjs",
        "tests/motion/fixtures/*.tsx"
      ]
    }
  },
  "ignoreDependencies": ["@iconify-json/fa6-regular", "@iconify-json/fa6-solid", "@iconify-json/gg", "@iconify-json/ri"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "tags": ["-lintignore"],
  "ignore": ["public/**"]
}
